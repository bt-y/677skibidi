-- Spectator Text Spoofer Only (Strictly modifies .Text, never instance .Name)
local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")
local lp = Players.LocalPlayer
local pg = lp:WaitForChild("PlayerGui")

local spoofViewName = false
local debugLines = {}

local function dbg(msg)
    msg = tostring(msg)
    table.insert(debugLines, os.date("%H:%M:%S") .. " | " .. msg)
    if #debugLines > 50 then table.remove(debugLines, 1) end
    pcall(function()
        if _G.__SpectateDebugLabel then
            _G.__SpectateDebugLabel.Text = table.concat(debugLines, "\n")
        end
    end)
end

-- Aggressive Text-Only Spectator Spoofer
local function updateSpectatorText(targetName, lookName)
    if not spoofViewName then return end
    pcall(function()
        local roots = {pg}
        pcall(function() table.insert(roots, CoreGui) end)
        
        for _, root in ipairs(roots) do
            for _, g in ipairs(root:GetDescendants()) do
                -- STRICTLY check TextLabel or TextButton and modify .Text ONLY. Never touch g.Name!
                if g:IsA("TextLabel") or g:IsA("TextButton") then
                    local t = g.Text or ""
                    if t ~= "" then
                        -- If the text contains the target player's name, replace it with the look name
                        if targetName ~= "" and string.find(t, targetName, 1, true) then
                            local newText = t:gsub(targetName, lookName)
                            if newText ~= t then
                                g.Text = newText
                            end
                        -- Or if it matches standard spectate UI patterns
                        local lower = string.lower(t)
                        if lower:find("viewing") or lower:find("spectat") or lower:find("watching") or lower:find("observer") then
                            g.Text = "Viewing " .. lookName
                        end
                    end
                end
            end
        end
    end)
end

