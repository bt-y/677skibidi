local function setStatus(t)
    pcall(statusFn, t)
end

local function getUserIdFromName(name)
    name = tostring(name or ""):gsub("^%s+", ""):gsub("%s+$", "")
    if name == "" then return nil end
    local id = nil
    pcall(function() id = Players:GetUserIdFromNameAsync(name) end)
    if not id then
        pcall(function()
            local req = request or (syn and syn.request) or (http and http.request)
            if req then
                local res = req({
                    Url = "https://users.roblox.com/v1/usernames/users",
                    Method = "POST",
                    Headers = {["Content-Type"] = "application/json"},
                    Body = HS:JSONEncode({usernames = {name}, excludeBannedUsers = true})
                })
                local body = res and (res.Body or res.body)
                if body then id = tonumber(string.match(body, '"id"%s*:%s*(%d+)')) end
            end
        end)
    end
    return id
end

local function stripVisuals(char)
    for _, c in ipairs(char:GetChildren()) do
        if c:IsA("Accessory") or c:IsA("Shirt") or c:IsA("Pants") or c:IsA("ShirtGraphic")
            or c:IsA("BodyColors") or c:IsA("CharacterMesh") then
            pcall(function() c:Destroy() end)
        end
    end
end

local function applyDesc(hum, desc)
    if not hum or not desc then return false end
    local ok = pcall(function() hum:ApplyDescription(desc) end)
    return ok
end

local function applyFromUserId(userId)
    local char = lp.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return false end
    local desc = nil
    pcall(function() desc = Players:GetHumanoidDescriptionFromUserId(tonumber(userId)) end)
    if not desc then return false end
    stripVisuals(char)
    task.wait(0.05)
    return applyDesc(hum, desc)
end

local function loadAssetModel()
    local model = nil
    pcall(function()
        local objs = game:GetObjects("rbxassetid://" .. tostring(ASSET_ID))
        if objs and objs[1] then model = objs[1] end
    end)
    if not model then
        pcall(function() model = InsertService:LoadAsset(ASSET_ID) end)
    end
    if not model then return nil end
    if model:IsA("Model") then
        local inner = model:FindFirstChildOfClass("Model")
        if inner and (inner:FindFirstChildOfClass("Humanoid") or inner:FindFirstChildOfClass("HumanoidDescription")) then
            return inner, model
        end
    end
    return model, model
end

local function applyFromAsset()
    local char = lp.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not char or not hum then return false end
    local avatar, bag = loadAssetModel()
    if not avatar then return false end
    local desc = avatar:FindFirstChildOfClass("HumanoidDescription")
    if not desc then
        for _, d in ipairs(avatar:GetDescendants()) do
            if d:IsA("HumanoidDescription") then desc = d break end
        end
    end
    if desc then
        stripVisuals(char)
        local ok = applyDesc(hum, desc:Clone())
        pcall(function() if bag then bag:Destroy() end end)
        return ok
    end
    stripVisuals(char)
    for _, c in ipairs(avatar:GetDescendants()) do
        if c:IsA("Accessory") or c:IsA("Shirt") or c:IsA("Pants") or c:IsA("ShirtGraphic") or c:IsA("BodyColors") then
            pcall(function() c:Clone().Parent = char end)
        end
    end
    local ah = avatar:FindFirstChildOfClass("Humanoid")
    if ah then
        pcall(function()
            local ad = ah:GetAppliedDescription()
            if ad then applyDesc(hum, ad) end
        end)
    end
    pcall(function() if bag then bag:Destroy() end end)
    return true
end

local function applyLook(targetName)
    local char = lp.Character
    if not char then char = lp.CharacterAdded:Wait() end
    local hum = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 8)
    if not hum then setStatus("No humanoid") return false end

    if useAssetModel then
        setStatus("Loading asset...")
        if applyFromAsset() then setStatus("Asset applied") return true end
        setStatus("Asset failed, trying user id...")
    end

    local uid = getUserIdFromName(targetName) or DEFAULT_USER_ID
    setStatus("UserId " .. tostring(uid))
    task.wait(0.1)
    if applyFromUserId(uid) then setStatus("Look applied") return true end
    setStatus("Apply failed")
    return false
end

lp.CharacterAdded:Connect(function()
    task.wait(1.2)
    if lastTarget and lastTarget ~= "" then applyLook(lastTarget) end
end)

local function setViewNameText(text)
    if not spoofViewName or text == "" then return end
    pcall(function()
        for _, g in ipairs(pg:GetDescendants()) do
            if g:IsA("TextLabel") or g:IsA("TextButton") then
                local t = g.Text or ""
                local lower = string.lower(t)
                if lower:find("viewing") or lower:find("spectat") or lower:find("watching") then
                    local newT = t
                    newT = string.gsub(newT, "([Vv]iewing%s+)[%w_]+", "%1" .. text)
                    newT = string.gsub(newT, "([Ss]pectating%s+)[%w_]+", "%1" .. text)
                    newT = string.gsub(newT, "([Ww]atching%s+)[%w_]+", "%1" .. text)
                    if newT ~= t then g.Text = newT end
                end
            end
        end
    end)
end

task.spawn(function()
    while true do
        task.wait(0.35)
        if spoofViewName and viewNameOverride ~= "" then setViewNameText(viewNameOverride) end
    end
end)

