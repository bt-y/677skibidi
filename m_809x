local function dbg(msg)
    msg = tostring(msg)
    pcall(function()
        if _G.__MainDebugLabel then
            _G.__MainDebugLabel.Text = os.date("%H:%M:%S") .. " | " .. msg
        end
    end)
end

local function getPlayerByName(name)
    name = tostring(name or ""):gsub("^%s+", ""):gsub("%s+$", "")
    if name == "" then return nil end
    for _, pl in ipairs(Players:GetPlayers()) do
        if string.lower(pl.Name) == string.lower(name) then return pl end
    end
    for _, pl in ipairs(Players:GetPlayers()) do
        if string.find(string.lower(pl.Name), string.lower(name), 1, true) then return pl end
    end
    return nil
end

-- Avatar Changer Function (Shirts & Pants)
local function applyCustomLook(tName, lSource)
    dbg("Applying avatar look...")
    local targetPl = getPlayerByName(tName)
    if not targetPl then
        dbg("Error: Target player not found")
        return false
    end
    
    local char = targetPl.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then
        dbg("Error: Target character missing")
        return false
    end

    -- Clear old clothes
    for _, c in ipairs(char:GetChildren()) do
        if c:IsA("Shirt") or c:IsA("Pants") or c:IsA("ShirtGraphic") then
            pcall(function() c:Destroy() end)
        end
    end

    local targetUserId = tonumber(lSource)
    if not targetUserId then
        pcall(function() targetUserId = Players:GetUserIdFromNameAsync(lSource) end)
    end

    if targetUserId then
        pcall(function()
            local desc = Players:GetHumanoidDescriptionFromUserId(targetUserId)
            if desc then
                local model = Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R6)
                if model then
                    for _, child in ipairs(model:GetDescendants()) do
                        if child:IsA("Shirt") or child:IsA("Pants") then
                            pcall(function()
                                child:Clone().Parent = char
                            end)
                        end
                    end
                    model:Destroy()
                end
            end
        end)
    end
    dbg("Avatar look applied successfully!")
    return true
end

-- Instant Spectator Text Spoofer (Flicker-Free Event Listener)
local function handleTextLabel(label)
    if label:GetAttribute("SpoofedConnected") then return end
    label:SetAttribute("SpoofedConnected", true)

    local function update()
        if not spectateSpoofActive then return end
        local t = label.Text or ""
        if t ~= "" then
            if targetName ~= "" and string.find(t, targetName, 1, true) then
                local newText = t:gsub(targetName, lookName)
                if newText ~= t then label.Text = newText end
            elseif string.lower(t):find("viewing") or string.lower(t):find("spectat") or string.lower(t):find("watching") then
                label.Text = "Viewing " .. lookName
            end
        end
    end

    update()
    label:GetPropertyChangedSignal("Text"):Connect(update)
end

-- Scan UI roots for text labels
local function scanRoots()
    local roots = {pg}
    pcall(function() table.insert(roots, CoreGui) end)
    for _, root in ipairs(roots) do
        for _, desc in ipairs(root:GetDescendants()) do
            if desc:IsA("TextLabel") or desc:IsA("TextButton") then
                handleTextLabel(desc)
            end
        end
        root.DescendantAdded:Connect(function(desc)
            if desc:IsA("TextLabel") or desc:IsA("TextButton") then
                handleTextLabel(desc)
            end
        end)
    end
end

