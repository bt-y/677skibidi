-- Master Control Script: Workspace Model Renamer & Spectator Text Spoofer
local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")
local Workspace = game:GetService("Workspace")
local LocalPlayer = Players.LocalPlayer or Players.PlayerAdded:Wait()
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

-- States
local workspaceRenameActive = false
local spectateSpoofActive = false
local targetName = "naimradio66"
local newName = "m_809x"

-- Create GUI Safely
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "MasterSpoofGui"
ScreenGui.ResetOnSpawn = false
ScreenGui.IgnoreGuiInset = true

local success = pcall(function()
    ScreenGui.Parent = CoreGui
end)
if not success then
    ScreenGui.Parent = PlayerGui
end

local MainFrame = Instance.new("Frame")
MainFrame.Size = UDim2.fromOffset(300, 240)
MainFrame.Position = UDim2.new(0.5, -150, 0.3, 0)
MainFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
MainFrame.Active = true
MainFrame.Draggable = true
MainFrame.Parent = ScreenGui

Instance.new("UICorner", MainFrame).CornerRadius = UDim.new(0, 8)

local Title = Instance.new("TextLabel")
Title.Size = UDim2.new(1, -30, 0, 30)
Title.Position = UDim2.new(0, 10, 0, 5)
Title.BackgroundTransparency = 1
Title.Text = "Control Panel"
Title.TextColor3 = Color3.fromRGB(255, 255, 255)
Title.Font = Enum.Font.GothamBold
Title.TextSize = 14
Title.TextXAlignment = Enum.TextXAlignment.Left
Title.Parent = MainFrame

local CloseBtn = Instance.new("TextButton")
CloseBtn.Size = UDim2.fromOffset(24, 24)
CloseBtn.Position = UDim2.new(1, -28, 0, 8)
CloseBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
CloseBtn.Text = "X"
CloseBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
CloseBtn.Font = Enum.Font.GothamBold
CloseBtn.TextSize = 12
CloseBtn.Parent = MainFrame
Instance.new("UICorner", CloseBtn).CornerRadius = UDim.new(0, 4)
CloseBtn.MouseButton1Click:Connect(function()
    ScreenGui:Destroy()
end)

-- Toggle 1: Workspace Model Renamer
local WorkspaceBtn = Instance.new("TextButton")
WorkspaceBtn.Size = UDim2.new(1, -20, 0, 36)
WorkspaceBtn.Position = UDim2.new(0, 10, 0, 45)
WorkspaceBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
WorkspaceBtn.Text = "Workspace Rename: OFF"
WorkspaceBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
WorkspaceBtn.Font = Enum.Font.GothamBold
WorkspaceBtn.TextSize = 12
WorkspaceBtn.Parent = MainFrame
Instance.new("UICorner", WorkspaceBtn).CornerRadius = UDim.new(0, 6)

WorkspaceBtn.MouseButton1Click:Connect(function()
    workspaceRenameActive = not workspaceRenameActive
    if workspaceRenameActive then
        WorkspaceBtn.Text = "Workspace Rename: ON"
        WorkspaceBtn.BackgroundColor3 = Color3.fromRGB(40, 150, 40)
    else
        WorkspaceBtn.Text = "Workspace Rename: OFF"
        WorkspaceBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    end
end)

-- Toggle 2: Spectator Text Spoofer
local SpectateBtn = Instance.new("TextButton")
SpectateBtn.Size = UDim2.new(1, -20, 0, 36)
SpectateBtn.Position = UDim2.new(0, 10, 0, 90)
SpectateBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
SpectateBtn.Text = "Spectate Spoofer: OFF"
SpectateBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
SpectateBtn.Font = Enum.Font.GothamBold
SpectateBtn.TextSize = 12
SpectateBtn.Parent = MainFrame
Instance.new("UICorner", SpectateBtn).CornerRadius = UDim.new(0, 6)

SpectateBtn.MouseButton1Click:Connect(function()
    spectateSpoofActive = not spectateSpoofActive
    if spectateSpoofActive then
        SpectateBtn.Text = "Spectate Spoofer: ON"
        SpectateBtn.BackgroundColor3 = Color3.fromRGB(40, 150, 40)
    else
        SpectateBtn.Text = "Spectate Spoofer: OFF"
        SpectateBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    end
end)

-- Status Label
local StatusLabel = Instance.new("TextLabel")
StatusLabel.Size = UDim2.new(1, -20, 0, 80)
StatusLabel.Position = UDim2.new(0, 10, 0, 140)
StatusLabel.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
StatusLabel.Text = "Status: Ready.\nTarget: naimradio66\nNew: m_809x"
StatusLabel.TextColor3 = Color3.fromRGB(150, 255, 150)
StatusLabel.Font = Enum.Font.Code
StatusLabel.TextSize = 11
StatusLabel.TextXAlignment = Enum.TextXAlignment.Left
StatusLabel.TextYAlignment = Enum.TextYAlignment.Top
StatusLabel.TextWrapped = true
StatusLabel.Parent = MainFrame
Instance.new("UICorner", StatusLabel).CornerRadius = UDim.new(0, 6)

-- Background Loops for Modes
task.spawn(function()
    while true do
        task.wait(0.2)
        
        -- Mode 2: Workspace Model Rename
        if workspaceRenameActive then
            pcall(function()
                for _, obj in ipairs(Workspace:GetChildren()) do
                    if obj:IsA("Model") and obj.Name == targetName then
                        obj.Name = newName
                    end
                end
            end)
        end

        -- Mode 1: Spectator Text Spoofer
        if spectateSpoofActive then
            pcall(function()
                local roots = {PlayerGui}
                pcall(function() table.insert(roots, CoreGui) end)
                
                for _, root in ipairs(roots) do
                    for _, desc in ipairs(root:GetDescendants()) do
                        if desc:IsA("TextLabel") or desc:IsA("TextButton") then
                            local text = desc.Text
                            if text and text ~= "" then
                                if string.find(text, targetName, 1, true) then
                                    desc.Text = text:gsub(targetName, newName)
                                elseif string.lower(text):find("viewing") or string.lower(text):find("spectat") then
                                    desc.Text = "Viewing " .. newName
                                end
                            end
                        end
                    end
                end
            end)
        end
    end
end)
