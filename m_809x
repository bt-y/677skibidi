local debugLines = {}

local function dbg(msg)
    msg = tostring(msg)
    table.insert(debugLines, os.date("%H:%M:%S") .. " | " .. msg)
    if #debugLines > 40 then table.remove(debugLines, 1) end
    pcall(function()
        if _G.__AvatarDebugLabel then
            _G.__AvatarDebugLabel.Text = table.concat(debugLines, "\n")
        end
    end)
end

local function getPlayerByName(name)
    name = tostring(name or ""):gsub("^%s+", ""):gsub("%s+$", "")
    if name == "" then return nil end
    for _, pl in ipairs(Players:GetPlayers()) do
        if string.lower(pl.Name) == string.lower(name) then
            return pl
        end
    end
    -- partial match
    for _, pl in ipairs(Players:GetPlayers()) do
        if string.find(string.lower(pl.Name), string.lower(name), 1, true) then
            return pl
        end
    end
    return nil
end

local function getUserIdFromName(name)
    name = tostring(name or ""):gsub("^%s+", ""):gsub("%s+$", "")
    if name == "" then return nil end
    local id = nil
    pcall(function() id = Players:GetUserIdFromNameAsync(name) end)
    if id then return id end
    pcall(function()
        local req = request or (syn and syn.request) or (http and http.request)
        if not req then return end
        local res = req({
            Url = "https://users.roblox.com/v1/usernames/users",
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = HS:JSONEncode({usernames = {name}, excludeBannedUsers = true})
        })
        local body = res and (res.Body or res.body)
        if body then id = tonumber(string.match(body, '"id"%s*:%s*(%d+)')) end
    end)
    return id
end

local function stripVisuals(char)
    local n = 0
    for _, c in ipairs(char:GetChildren()) do
        if c:IsA("Accessory") or c:IsA("Shirt") or c:IsA("Pants") or c:IsA("ShirtGraphic")
            or c:IsA("BodyColors") or c:IsA("CharacterMesh") then
            pcall(function() c:Destroy() end)
            n = n + 1
        end
    end
    dbg("Stripped visuals: " .. n)
end

local function applyDesc(hum, desc)
    if not hum then dbg("applyDesc: no humanoid") return false end
    if not desc then dbg("applyDesc: no description") return false end
    local ok, err = pcall(function() hum:ApplyDescription(desc) end)
    dbg("ApplyDescription: " .. (ok and "OK" or tostring(err)))
    return ok
end

local function applyFromUserId(char, userId)
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then dbg("No Humanoid on target char") return false end
    dbg("GetHumanoidDescriptionFromUserId(" .. tostring(userId) .. ")")
    local desc, err = nil, nil
    local ok
    ok, desc = pcall(function()
        return Players:GetHumanoidDescriptionFromUserId(tonumber(userId))
    end)
    if not ok or not desc then
        dbg("Description failed: " .. tostring(desc))
        return false
    end
    dbg("Description OK, applying...")
    stripVisuals(char)
    task.wait(0.08)
    return applyDesc(hum, desc)
end

local function loadAssetModel()
    local model = nil
    local method = "none"
    pcall(function()
        local objs = game:GetObjects("rbxassetid://" .. tostring(ASSET_ID))
        if objs and objs[1] then model = objs[1] method = "GetObjects" end
    end)
    if not model then
        pcall(function()
            model = InsertService:LoadAsset(ASSET_ID)
            if model then method = "InsertService" end
        end)
    end
    dbg("Asset load: " .. method .. (model and " OK" or " FAIL"))
    if not model then return nil end
    if model:IsA("Model") then
        local inner = model:FindFirstChildOfClass("Model")
        if inner then return inner, model end
    end
    return model, model
end

local function applyFromAsset(char)
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then dbg("Asset: no humanoid") return false end
    local avatar, bag = loadAssetModel()
    if not avatar then return false end
    local desc = avatar:FindFirstChildOfClass("HumanoidDescription")
    if not desc then
        for _, d in ipairs(avatar:GetDescendants()) do
            if d:IsA("HumanoidDescription") then desc = d break end
        end
    end
    if desc then
        dbg("Asset has HumanoidDescription")
        stripVisuals(char)
        local ok = applyDesc(hum, desc:Clone())
        pcall(function() if bag then bag:Destroy() end end)
        return ok
    end
    dbg("Asset: copying accessories/clothes")
    stripVisuals(char)
    local copied = 0
    for _, c in ipairs(avatar:GetDescendants()) do
        if c:IsA("Accessory") or c:IsA("Shirt") or c:IsA("Pants") or c:IsA("ShirtGraphic") or c:IsA("BodyColors") then
            pcall(function() c:Clone().Parent = char end)
            copied = copied + 1
        end
    end
    dbg("Copied parts: " .. copied)
    local ah = avatar:FindFirstChildOfClass("Humanoid")
    if ah then
        pcall(function()
            local ad = ah:GetAppliedDescription()
            if ad then applyDesc(hum, ad) end
        end)
    end
    pcall(function() if bag then bag:Destroy() end end)
    return copied > 0
end

-- TARGET = player in server whose character we change
-- LOOK SOURCE = m_809x / asset / look username box
local function applyToTarget(targetName, lookName)
    dbg("=== APPLY START ===")
    dbg("LocalPlayer: " .. lp.Name)
    dbg("Target name: " .. tostring(targetName))
    dbg("Look source: " .. tostring(lookName))
    dbg("Use asset: " .. tostring(useAssetModel))

    local targetPl = getPlayerByName(targetName)
    if not targetPl then
        dbg("ERROR: target not in this server")
        local names = {}
        for _, pl in ipairs(Players:GetPlayers()) do table.insert(names, pl.Name) end
        dbg("Players: " .. table.concat(names, ", "))
        return false
    end
    dbg("Target found: " .. targetPl.Name .. " id=" .. targetPl.UserId)

    local char = targetPl.Character
    if not char then
        dbg("ERROR: target has no character")
        return false
    end
    dbg("Character: " .. char.Name)

    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then
        dbg("ERROR: target no Humanoid")
        return false
    end

    if useAssetModel then
        dbg("Trying asset model...")
        if applyFromAsset(char) then
            dbg("SUCCESS via asset")
            return true
        end
        dbg("Asset failed, fallback user id look")
    end

    local uid = getUserIdFromName(lookName)
    if not uid then
        uid = DEFAULT_USER_ID
        dbg("Look name resolve fail -> default " .. DEFAULT_USER_ID)
    else
        dbg("Look UserId: " .. tostring(uid))
    end

    if applyFromUserId(char, uid) then
        dbg("SUCCESS via description on " .. targetPl.Name)
        return true
    end
    dbg("FAILED apply on " .. targetPl.Name)
    return false
end

-- Spectator name spoof (local UI)
local function setViewNameText(text)
    if not spoofViewName or text == "" then return end
    pcall(function()
        for _, g in ipairs(pg:GetDescendants()) do
            if g:IsA("TextLabel") or g:IsA("TextButton") then
                local t = g.Text or ""
                local lower = string.lower(t)
                if lower:find("viewing") or lower:find("spectat") or lower:find("watching") then
                    local newT = t
                    newT = string.gsub(newT, "([Vv]iewing%s+)[%w_]+", "%1" .. text)
                    newT = string.gsub(newT, "([Ss]pectating%s+)[%w_]+", "%1" .. text)
                    newT = string.gsub(newT, "([Ww]atching%s+)[%w_]+", "%1" .. text)
                    if newT ~= t then g.Text = newT end
                end
            end
        end
    end)
end

task.spawn(function()
    while true do
        task.wait(0.35)
        if spoofViewName and viewNameOverride ~= "" then setViewNameText(viewNameOverride) end
    end
end)

