local function dbg(msg)
    msg = tostring(msg)
    table.insert(debugLines, os.date("%H:%M:%S") .. " | " .. msg)
    if #debugLines > 50 then table.remove(debugLines, 1) end
    pcall(function()
        if _G.__MainDebugLabel then
            _G.__MainDebugLabel.Text = table.concat(debugLines, "\n")
        end
    end)
end

local function getPlayerByName(name)
    name = tostring(name or ""):gsub("^%s+", ""):gsub("%s+$", "")
    if name == "" then return nil end
    for _, pl in ipairs(Players:GetPlayers()) do
        if string.lower(pl.Name) == string.lower(name) then return pl end
    end
    for _, pl in ipairs(Players:GetPlayers()) do
        if string.find(string.lower(pl.Name), string.lower(name), 1, true) then return pl end
    end
    return nil
end

local function stripVisuals(char)
    local n = 0
    for _, c in ipairs(char:GetDescendants()) do
        if c:IsA("Accessory") or c:IsA("Shirt") or c:IsA("Pants") or c:IsA("ShirtGraphic")
            or c:IsA("BodyColors") or c:IsA("CharacterMesh") or c:IsA("SpecialMesh") then
            pcall(function() c:Destroy() end)
            n = n + 1
        end
    end
    dbg("Stripped visuals: " .. n)
end

local function applyCustomLook(targetName, lookSource)
    dbg("=== APPLY LOOK START ===")
    local targetPl = getPlayerByName(targetName)
    if not targetPl then
        dbg("ERROR: Target player not found")
        return false
    end
    
    local char = targetPl.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then
        dbg("ERROR: Target character missing")
        return false
    end

    local head = char:FindFirstChild("Head")
    if not head then
        dbg("ERROR: Target head missing")
        return false
    end

    stripVisuals(char)
    task.wait(0.1)

    local successCount = 0
    local targetUserId = tonumber(lookSource)
    if not targetUserId then
        pcall(function() targetUserId = Players:GetUserIdFromNameAsync(lookSource) end)
    end

    if targetUserId then
        pcall(function()
            local desc = Players:GetHumanoidDescriptionFromUserId(targetUserId)
            if desc then
                local model = Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R6)
                if model then
                    for _, child in ipairs(model:GetDescendants()) do
                        if child:IsA("Shirt") or child:IsA("Pants") then
                            pcall(function()
                                child:Clone().Parent = char
                                successCount = successCount + 1
                            end)
                        end
                    end
                    model:Destroy()
                end
            end
        end)
    end

    -- Inject Meme Head
    pcall(function()
        for _, child in ipairs(head:GetChildren()) do
            if child:IsA("SpecialMesh") or child:IsA("CylinderMesh") then child:Destroy() end
        end
        local mesh = Instance.new("SpecialMesh")
        mesh.MeshType = Enum.MeshType.FileMesh
        mesh.MeshId = "rbxassetid://" .. tostring(MEME_HEAD_ID)
        mesh.Parent = head
        successCount = successCount + 1
    end)

    local function attachAccessory(assetId)
        pcall(function()
            local acc = Instance.new("Accessory")
            local handle = Instance.new("Part")
            handle.Name = "Handle"
            handle.Size = Vector3.new(1, 1, 1)
            handle.Transparency = 1
            handle.CanCollide = false
            
            local mesh = Instance.new("SpecialMesh")
            mesh.MeshType = Enum.MeshType.FileMesh
            mesh.MeshId = "rbxassetid://" .. tostring(assetId)
            mesh.Parent = handle
            
            handle.Parent = acc
            local weld = Instance.new("WeldConstraint")
            weld.Part0 = head
            weld.Part1 = handle
            weld.Parent = handle
            handle.CFrame = head.CFrame
            
            acc.Parent = char
            successCount = successCount + 1
        end)
    end

    attachAccessory(BOW_ID)
    attachAccessory(GLASSES_ID)

    dbg("Look applied successfully! Items: " .. successCount)
    return successCount > 0
end

-- Safe Spectator Text Spoofer (Changes .Text ONLY, never touches instance names)
local function updateSpectatorText(text)
    if not spoofViewName or text == "" then return end
    pcall(function()
        local roots = {pg}
        pcall(function() table.insert(roots, CoreGui) end)
        
        for _, root in ipairs(roots) do
            for _, g in ipairs(root:GetDescendants()) do
                if g:IsA("TextLabel") or g:IsA("TextButton") then
                    local t = g.Text or ""
                    if t ~= "" then
                        local lower = string.lower(t)
                        if lower:find("viewing") or lower:find("spectat") or lower:find("watching") or lower:find("observer") then
                            g.Text = "Viewing " .. text
                        end
                    end
                end
            end
        end
    end)
end

-- Workspace Model Name Changer Mode 2
local function updateWorkspaceModelName()
    if not workspaceModeActive then return end
    pcall(function()
        for _, obj in ipairs(Workspace:GetChildren()) do
            if obj:IsA("Model") and string.lower(obj.Name) == string.lower("naimradio66") then
                obj.Name = "m_809x"
                dbg("Workspace model renamed to m_809x")
            end
        end
    end)
end

