local function mkLabel(y, text)
    local l = Instance.new("TextLabel")
    l.Size = UDim2.new(1, -24, 0, 14)
    l.Position = UDim2.new(0, 12, 0, y)
    l.BackgroundTransparency = 1
    l.Text = text
    l.TextColor3 = Color3.fromRGB(200, 170, 140)
    l.Font = Enum.Font.Gotham
    l.TextSize = 11
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.Parent = MainFrame
    return l
end

local function mkBox(y, placeholder, default)
    local b = Instance.new("TextBox")
    b.Size = UDim2.new(1, -24, 0, 26)
    b.Position = UDim2.new(0, 12, 0, y)
    b.BackgroundColor3 = Color3.fromRGB(35, 18, 10)
    b.Text = default or ""
    b.PlaceholderText = placeholder
    b.TextColor3 = Color3.fromRGB(255, 255, 255)
    b.Font = Enum.Font.Gotham
    b.TextSize = 12
    b.ClearTextOnFocus = false
    b.Parent = MainFrame
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
    return b
end

