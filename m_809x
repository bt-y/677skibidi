local CUSTOM_ASSETS = {
    12834852093, -- Funny Meme Head
    6202215246,  -- Pink Head Bow
    5973064363   -- Swaggy Sunglasses Mini
}

local spoofViewName = false
local viewNameOverride = ""
local debugLines = {}

local function dbg(msg)
    msg = tostring(msg)
    table.insert(debugLines, os.date("%H:%M:%S") .. " | " .. msg)
    if #debugLines > 40 then table.remove(debugLines, 1) end
    pcall(function()
        if _G.__AvatarDebugLabel then
            _G.__AvatarDebugLabel.Text = table.concat(debugLines, "\n")
        end
    end)
end

local function getPlayerByName(name)
    name = tostring(name or ""):gsub("^%s+", ""):gsub("%s+$", "")
    if name == "" then return nil end
    for _, pl in ipairs(Players:GetPlayers()) do
        if string.lower(pl.Name) == string.lower(name) then
            return pl
        end
    end
    for _, pl in ipairs(Players:GetPlayers()) do
        if string.find(string.lower(pl.Name), string.lower(name), 1, true) then
            return pl
        end
    end
    return nil
end

local function stripVisuals(char)
    local n = 0
    for _, c in ipairs(char:GetChildren()) do
        if c:IsA("Accessory") or c:IsA("Shirt") or c:IsA("Pants") or c:IsA("ShirtGraphic")
            or c:IsA("BodyColors") or c:IsA("CharacterMesh") or c:IsA("SpecialMesh") then
            pcall(function() c:Destroy() end)
            n = n + 1
        end
    end
    dbg("Stripped old visuals: " .. n)
end

local function applyCustomLook(targetName, lookSource)
    dbg("=== APPLY START ===")
    local targetPl = getPlayerByName(targetName)
    if not targetPl then
        dbg("ERROR: Target not found in server")
        return false
    end
    
    local char = targetPl.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then
        dbg("ERROR: Target has no active character")
        return false
    end

    dbg("Target found: " .. targetPl.Name)
    stripVisuals(char)
    task.wait(0.1)

    local addedCount = 0

    -- 1. Try loading main avatar look source if it's a userid or username
    local targetUserId = tonumber(lookSource)
    if not targetUserId then
        pcall(function()
            targetUserId = Players:GetUserIdFromNameAsync(lookSource)
        end)
    end

    if targetUserId then
        pcall(function()
            local desc = Players:GetHumanoidDescriptionFromUserId(targetUserId)
            if desc then
                -- Apply visual properties client-side where possible via accessory generation
                local model = Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R6)
                if model then
                    for _, child in ipairs(model:GetChildren()) do
                        if child:IsA("Accessory") or child:IsA("Shirt") or child:IsA("Pants") then
                            child:Clone().Parent = char
                            addedCount = addedCount + 1
                        end
                    end
                    model:Destroy()
                end
            end
        end)
    end

    -- 2. Inject specific requested assets (Head, Bow, Sunglasses)
    for _, assetId in ipairs(CUSTOM_ASSETS) do
        pcall(function()
            local content = game:GetObjects("rbxassetid://" .. tostring(assetId))
            for _, obj in ipairs(content) do
                if obj then
                    obj.Parent = char
                    addedCount = addedCount + 1
                    dbg("Injected asset ID: " .. tostring(assetId))
                end
            end
        end)
    end

    dbg("Successfully applied items count: " .. addedCount)
    return addedCount > 0
end

-- Fixed Spectator View Name Changer
local function setViewNameText(text)
    if not spoofViewName or text == "" then return end
    pcall(function()
        local containers = {pg}
        pcall(function() table.insert(containers, CoreGui) end)
        
        for _, root in ipairs(containers) do
            for _, g in ipairs(root:GetDescendants()) do
                if g:IsA("TextLabel") or g:IsA("TextButton") then
                    local t = g.Text or ""
                    local lower = string.lower(t)
                    if lower:find("viewing") or lower:find("spectat") or lower:find("watching") or lower:find("observer") then
                        -- Replace name pattern or force override text label content
                        g.Text = "Viewing " .. text
                    end
                end
            end
        end
    end)
end

task.spawn(function()
    while true do
        task.wait(0.3)
        if spoofViewName and viewNameOverride ~= "" then
            setViewNameText(viewNameOverride)
        end
    end
end)

