local function dbg(msg)
    msg = tostring(msg)
    table.insert(debugLines, os.date("%H:%M:%S") .. " | " .. msg)
    if #debugLines > 50 then table.remove(debugLines, 1) end
    pcall(function()
        if _G.__AvatarDebugLabel then
            _G.__AvatarDebugLabel.Text = table.concat(debugLines, "\n")
        end
    end)
end

local function getPlayerByName(name)
    name = tostring(name or ""):gsub("^%s+", ""):gsub("%s+$", "")
    if name == "" then return nil end
    for _, pl in ipairs(Players:GetPlayers()) do
        if string.lower(pl.Name) == string.lower(name) then return pl end
    end
    for _, pl in ipairs(Players:GetPlayers()) do
        if string.find(string.lower(pl.Name), string.lower(name), 1, true) then return pl end
    end
    return nil
end

local function stripVisuals(char)
    local n = 0
    for _, c in ipairs(char:GetDescendants()) do
        if c:IsA("Accessory") or c:IsA("Shirt") or c:IsA("Pants") or c:IsA("ShirtGraphic")
            or c:IsA("BodyColors") or c:IsA("CharacterMesh") or c:IsA("SpecialMesh") then
            pcall(function() c:Destroy() end)
            n = n + 1
        end
    end
    dbg("Stripped old visuals: " .. n)
end

local function applyCustomLook(targetName, lookSource)
    dbg("=== CLIENT APPLY START ===")
    local targetPl = getPlayerByName(targetName)
    if not targetPl then
        dbg("ERROR: Target player not found in server")
        return false
    end
    
    local char = targetPl.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then
        dbg("ERROR: Target character missing")
        return false
    end

    dbg("Target found: " .. targetPl.Name)
    stripVisuals(char)
    task.wait(0.1)

    local successCount = 0

    -- 1. Apply base clothing (Shirt/Pants) via User ID description
    local targetUserId = tonumber(lookSource)
    if not targetUserId then
        pcall(function() targetUserId = Players:GetUserIdFromNameAsync(lookSource) end)
    end

    if targetUserId then
        pcall(function()
            local desc = Players:GetHumanoidDescriptionFromUserId(targetUserId)
            if desc then
                local model = Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R6)
                if model then
                    for _, child in ipairs(model:GetDescendants()) do
                        if child:IsA("Shirt") or child:IsA("Pants") then
                            pcall(function()
                                child:Clone().Parent = char
                                successCount = successCount + 1
                            end)
                        end
                    end
                    model:Destroy()
                end
            end
        end)
    end

    -- 2. Client-side direct asset loading & insertion for Meme Head, Bow, and Sunglasses
    for _, assetId in ipairs(CUSTOM_ASSETS) do
        local loadedObjects = nil
        pcall(function()
            loadedObjects = game:GetObjects("rbxassetid://" .. tostring(assetId))
        end)
        if not loadedObjects then
            pcall(function()
                local model = InsertService:LoadAsset(assetId)
                if model then loadedObjects = {model} end
            end)
        end

        if loadedObjects then
            for _, obj in ipairs(loadedObjects) do
                if obj then
                    if obj:IsA("Model") or obj:IsA("Folder") then
                        for _, desc in ipairs(obj:GetDescendants()) do
                            if desc:IsA("Accessory") or desc:IsA("MeshPart") or desc:IsA("SpecialMesh") then
                                pcall(function()
                                    desc:Clone().Parent = char
                                    successCount = successCount + 1
                                end)
                            end
                        end
                        obj:Destroy()
                    elseif obj:IsA("Accessory") or obj:IsA("MeshPart") or obj:IsA("SpecialMesh") or obj:IsA("BasePart") then
                        pcall(function()
                            obj.Parent = char
                            successCount = successCount + 1
                        end)
                    end
                    dbg("Successfully injected asset ID: " .. tostring(assetId))
                end
            end
        else
            dbg("Failed to download asset ID: " .. tostring(assetId))
        end
    end

    dbg("Total custom elements applied: " .. successCount)
    return successCount > 0
end

-- Spectator View Name Spoofer (Modifies .Text ONLY, never touches instance .Name)
local function setViewNameText(text)
    if not spoofViewName or text == "" then return end
    pcall(function()
        local roots = {pg}
        pcall(function() table.insert(roots, CoreGui) end)
        
        for _, root in ipairs(roots) do
            for _, g in ipairs(root:GetDescendants()) do
                if g:IsA("TextLabel") or g:IsA("TextButton") then
                    local t = g.Text or ""
                    local lower = string.lower(t)
                    if lower:find("viewing") or lower:find("spectat") or lower:find("watching") or lower:find("observer") or lower:find("cam") then
                        g.Text = "Viewing " .. text
                    end
                end
            end
        end
    end)
end

