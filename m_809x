local pg = lp:WaitForChild("PlayerGui")

local DEFAULT_USER_ID = 2680311444 -- m_809x
local ASSET_ID = 105603353657140

local viewNameOverride = ""
local spoofViewName = false
local useAssetModel = false

-- =========================================================
-- APPEARANCE
-- =========================================================
local function getUserIdFromName(name)
    name = tostring(name or ""):gsub("^%s+", ""):gsub("%s+$", "")
    if name == "" then return nil end
    local id = nil
    pcall(function()
        id = Players:GetUserIdFromNameAsync(name)
    end)
    return id
end

local function clearCharacterAccessories(char)
    for _, c in ipairs(char:GetChildren()) do
        if c:IsA("Accessory") or c:IsA("Shirt") or c:IsA("Pants") or c:IsA("ShirtGraphic")
            or c:IsA("BodyColors") or c:IsA("CharacterMesh") then
            pcall(function() c:Destroy() end)
        end
    end
    local head = char:FindFirstChild("Head")
    if head then
        for _, c in ipairs(head:GetChildren()) do
            if c:IsA("Decal") and c.Name == "face" then
                -- keep slot, description will replace
            end
        end
    end
end

local function applyHumanoidDescription(userId)
    local char = lp.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return false end
    local ok, desc = pcall(function()
        return Players:GetHumanoidDescriptionFromUserId(userId)
    end)
    if not ok or not desc then return false end
    pcall(function()
        hum:ApplyDescription(desc)
    end)
    -- some executors need client replicate
    pcall(function()
        hum:ApplyDescriptionClient(desc)
    end)
    return true
end

local function applyAssetModel()
    local char = lp.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not char or not root or not hum then return false end

    local model = nil
    pcall(function()
        model = InsertService:LoadAsset(ASSET_ID)
    end)
    if not model then
        pcall(function()
            local objs = game:GetObjects("rbxassetid://" .. tostring(ASSET_ID))
            if objs and objs[1] then model = objs[1] end
        end)
    end
    if not model then return false end

    local avatar = model:IsA("Model") and model or model:FindFirstChildOfClass("Model")
    if not avatar then
        avatar = model
    end

    -- Prefer HumanoidDescription from asset if present
    local desc = avatar:FindFirstChildOfClass("HumanoidDescription")
    if desc then
        pcall(function() hum:ApplyDescription(desc:Clone()) end)
        pcall(function() model:Destroy() end)
        return true
    end

    -- Fallback: copy accessories / clothing from asset onto character
    clearCharacterAccessories(char)
    for _, c in ipairs(avatar:GetChildren()) do
        if c:IsA("Accessory") or c:IsA("Shirt") or c:IsA("Pants") or c:IsA("ShirtGraphic") or c:IsA("BodyColors") then
            pcall(function()
                local cl = c:Clone()
                cl.Parent = char
            end)
        end
    end
    pcall(function() model:Destroy() end)
    return true
end

local function applyLook(targetName)
    local char = lp.Character or lp.CharacterAdded:Wait()
    if not char:FindFirstChildOfClass("Humanoid") then
        char:WaitForChild("Humanoid", 5)
    end

    if useAssetModel then
        if applyAssetModel() then return true end
    end

    local uid = getUserIdFromName(targetName)
    if not uid then uid = DEFAULT_USER_ID end
    return applyHumanoidDescription(uid)
end

-- Re-apply after respawn if last target saved
local lastTarget = "m_809x"
lp.CharacterAdded:Connect(function()
    task.wait(1)
    if lastTarget and lastTarget ~= "" then
        applyLook(lastTarget)
    end
end)

-- =========================================================
-- SPECTATOR / "VIEWING" NAME SPOOF
-- =========================================================
local function setViewNameText(text)
    if not spoofViewName or text == "" then return end
    pcall(function()
        for _, g in ipairs(pg:GetDescendants()) do
            if g:IsA("TextLabel") or g:IsA("TextButton") then
                local t = g.Text or ""
                local lower = string.lower(t)
                -- common spectator patterns
                if lower:find("viewing") or lower:find("spectat") or lower:find("watching")
                    or lower:find("now watching") or lower:find("camera") then
                    -- replace username-like tail or whole line
                    local newT = t
                    -- "Viewing PlayerName" / "Spectating PlayerName"
                    newT = string.gsub(newT, "([Vv]iewing%s+)[%w_]+", "%1" .. text)
                    newT = string.gsub(newT, "([Ss]pectating%s+)[%w_]+", "%1" .. text)
                    newT = string.gsub(newT, "([Ww]atching%s+)[%w_]+", "%1" .. text)
                    if newT == t and #t < 40 and not lower:find("viewing") then
                        -- pure username label near spectator UI
                        if g.Parent and string.lower(g.Parent.Name):find("spect") then
                            newT = text
                        end
                    end
                    if newT ~= t then
                        g.Text = newT
                    end
                end
            end
        end
    end)
end

-- continuous soft overwrite while enabled
task.spawn(function()
    while true do
        task.wait(0.35)
        if spoofViewName and viewNameOverride ~= "" then
            setViewNameText(viewNameOverride)
        end
    end
end)

pg.DescendantAdded:Connect(function(obj)
    if not spoofViewName or viewNameOverride == "" then return end
    task.defer(function()
        if obj:IsA("TextLabel") or obj:IsA("TextButton") then
            setViewNameText(viewNameOverride)
        end
    end)
end)

