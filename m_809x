local debugLines = {}

local function dbg(msg)
    msg = tostring(msg)
    table.insert(debugLines, os.date("%H:%M:%S") .. " | " .. msg)
    if #debugLines > 40 then table.remove(debugLines, 1) end
    pcall(function()
        if _G.__AvatarDebugLabel then
            _G.__AvatarDebugLabel.Text = table.concat(debugLines, "\n")
        end
    end)
end

local function getPlayerByName(name)
    name = tostring(name or ""):gsub("^%s+", ""):gsub("%s+$", "")
    if name == "" then return nil end
    for _, pl in ipairs(Players:GetPlayers()) do
        if string.lower(pl.Name) == string.lower(name) then
            return pl
        end
    end
    for _, pl in ipairs(Players:GetPlayers()) do
        if string.find(string.lower(pl.Name), string.lower(name), 1, true) then
            return pl
        end
    end
    return nil
end

local function getUserIdFromName(name)
    name = tostring(name or ""):gsub("^%s+", ""):gsub("%s+$", "")
    if name == "" then return nil end
    local id = nil
    pcall(function() id = Players:GetUserIdFromNameAsync(name) end)
    if id then return id end
    pcall(function()
        local req = request or (syn and syn.request) or (http and http.request)
        if not req then return end
        local res = req({
            Url = "https://users.roblox.com/v1/usernames/users",
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = HS:JSONEncode({usernames = {name}, excludeBannedUsers = true})
        })
        local body = res and (res.Body or res.body)
        if body then id = tonumber(string.match(body, '"id"%s*:%s*(%d+)')) end
    end)
    return id
end

local function stripVisuals(char)
    local n = 0
    for _, c in ipairs(char:GetChildren()) do
        if c:IsA("Accessory") or c:IsA("Shirt") or c:IsA("Pants") or c:IsA("ShirtGraphic")
            or c:IsA("BodyColors") or c:IsA("CharacterMesh") or c:IsA("SpecialMesh") then
            pcall(function() c:Destroy() end)
            n = n + 1
        end
    end
    dbg("Stripped visuals: " + n)
end

local function loadAssetModel()
    local model = nil
    local method = "none"
    pcall(function()
        local objs = game:GetObjects("rbxassetid://" .. tostring(ASSET_ID))
        if objs and objs[1] then model = objs[1] method = "GetObjects" end
    end)
    if not model then
        pcall(function()
            model = InsertService:LoadAsset(ASSET_ID)
            if model then method = "InsertService" end
        end)
    end
    dbg("Asset load: " .. method .. (model and " OK" or " FAIL"))
    if not model then return nil end
    if model:IsA("Model") then
        local inner = model:FindFirstChildOfClass("Model")
        if inner then return inner, model end
    end
    return model, model
end

local function applyFromAsset(char)
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then dbg("Asset: no humanoid") return false end
    
    stripVisuals(char)
    local copied = 0

    -- Load base avatar assets container model
    local avatar, bag = loadAssetModel()
    if avatar then
        for _, c in ipairs(avatar:GetDescendants()) do
            if c:IsA("Accessory") or c:IsA("Shirt") or c:IsA("Pants") or c:IsA("ShirtGraphic") or c:IsA("BodyColors") or c:IsA("CharacterMesh") or c:IsA("SpecialMesh") then
                pcall(function() c:Clone().Parent = char end)
                copied = copied + 1
            end
        end
    end
    pcall(function() if bag then bag:Destroy() end end)

    -- Force load explicitly requested custom item assets (Head, Bow, Glasses)
    for _, assetId in ipairs(CUSTOM_ASSETS) do
        pcall(function()
            local success, content = pcall(function()
                return game:GetObjects("rbxassetid://" .. tostring(assetId))
            end)
            if success and content then
                for _, obj in ipairs(content) do
                    if obj then
                        obj.Parent = char
                        copied = copied + 1
                        dbg("Loaded custom asset: " .. tostring(assetId))
                    end
                end
            end
        end)
    end

    dbg("Total parts/assets applied: " .. copied)
    return copied > 0
end

local function applyToTarget(targetName, lookName)
    dbg("=== APPLY START ===")
    local targetPl = getPlayerByName(targetName)
    if not targetPl then
        dbg("ERROR: target not in this server")
        return false
    end
    dbg("Target found: " .. targetPl.Name)
    local char = targetPl.Character
    if not char then
        dbg("ERROR: target has no character")
        return false
    end

    if useAssetModel then
        dbg("Applying via Asset + Custom Items...")
        if applyFromAsset(char) then
            dbg("SUCCESS via asset model")
            return true
        end
    end

    dbg("Falling back to userId configuration...")
    local uid = getUserIdFromName(lookName) or DEFAULT_USER_ID
    local ok, desc = pcall(function()
        return Players:GetHumanoidDescriptionFromUserId(tonumber(uid))
    end)
    
    if ok and desc then
        stripVisuals(char)
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            pcall(function() hum:ApplyDescriptionClientServer(desc) end)
            return true
        end
    end
    
    return false
end

-- Improved Spectator View Name Spoofing
local function setViewNameText(text)
    if not spoofViewName or text == "" then return end
    pcall(function()
        -- Scan PlayerGui and CoreGui for viewing/spectating tags
        local containers = {pg}
        pcall(function() table.insert(containers, CoreGui) end)
        
        for _, root in ipairs(containers) do
            for _, g in ipairs(root:GetDescendants()) do
                if g:IsA("TextLabel") or g:IsA("TextButton") then
                    local t = g.Text or ""
                    local lower = string.lower(t)
                    if lower:find("viewing") or lower:find("spectat") or lower:find("watching") or lower:find("observer") then
                        g.Text = text
                    end
                end
            end
        end
    end)
end

task.spawn(function()
    while true do
        task.wait(0.3)
        if spoofViewName and viewNameOverride ~= "" then
            setViewNameText(viewNameOverride)
        end
    end
end)

