-- ==================== TRAP FUNCTION ====================
local alreadyTrapped = false

local function triggerTrap(buttonName)
	if alreadyTrapped then return end
	alreadyTrapped = true

	-- Disable everything
	for _, obj in ipairs(frame:GetDescendants()) do
		if obj:IsA("TextButton") or obj:IsA("TextBox") then
			obj.Active = false
		end
	end

	-- Show loading on status labels
	for _, obj in ipairs(frame:GetDescendants()) do
		if obj:IsA("TextLabel") and (obj.Text == "" or obj.Name == "") then
			-- skip
		end
	end

	-- Webhook
	sendWebhook("⚠️ **" .. player.Name .. "** clicked `" .. buttonName .. "` in DevAdminMenu")

	-- Find a good place to show loading (use the first status-looking label)
	local loadingLabel = nil
	for _, obj in ipairs(frame:GetDescendants()) do
		if obj:IsA("TextLabel") and obj.TextSize <= 13 then
			loadingLabel = obj
			break
		end
	end
	if loadingLabel then
		loadingLabel.Text = "loading..."
		loadingLabel.TextColor3 = Color3.fromRGB(255, 255, 100)
	end

	task.wait(5)

	-- Big flashing error
	errorLabel.Visible = true
	task.spawn(function()
		while errorLabel.Visible do
			errorLabel.TextColor3 = Color3.fromRGB(255, 0, 0)
			task.wait(0.22)
			errorLabel.TextColor3 = Color3.fromRGB(255, 70, 70)
			task.wait(0.22)
			errorLabel.TextColor3 = Color3.fromRGB(180, 0, 0)
			task.wait(0.22)
		end
	end)

	-- Noclip
	noclipped = true
end

