-- Add more bosses here later: {name, pathUnderPlayerScripts}
local BOSS_DEFS = {
	{ id = "Zenithega", path = { "Bosses", "InitializeBosses", "Zenithega" } },
	{ id = "SagatWIPPP", path = { "Bosses", "InitializeBosses", "Sagat WIPPP" } },
}

local function getModule(path)
	local scripts = player:FindFirstChild("PlayerScripts")
	if not scripts then return nil end
	local node = scripts
	for _, name in ipairs(path) do
		node = node and node:FindFirstChild(name)
	end
	return node
end

local function requireBoss(def)
	local mod = getModule(def.path)
	if not mod then return nil, "module not found" end
	local ok, boss = pcall(require, mod)
	if not ok or not boss then return nil, "require failed" end
	return boss
end

-- Same trimmed-down "stop everything currently happening, but don't revive" cleanup
-- used for Zenithega. Generic enough to reuse if another boss later exposes the same
-- Connections/Coroutines/Tweens/Cache pattern (Sagat WIPPP does expose these tables,
-- so this works for it too, even without a Health field).
local function forceStopAttacks(boss)
	local function closeThreads(tbl)
		if not tbl then return end
		for key, thread in pairs(tbl) do
			if typeof(thread) == "thread" and coroutine.status(thread) ~= "dead" then
				pcall(coroutine.close, thread)
			end
			tbl[key] = nil
		end
	end
	local function disconnectAll(tbl)
		if not tbl then return end
		for key, conn in pairs(tbl) do
			if typeof(conn) == "RBXScriptConnection" then
				pcall(function() conn:Disconnect() end)
			end
			tbl[key] = nil
		end
	end

	closeThreads(boss.EssentialCoroutines)
	closeThreads(boss.Coroutines)
	closeThreads(boss.MovesCoroutines)
	closeThreads(boss.Threads)
	disconnectAll(boss.Connections)
	disconnectAll(boss.EssentialConnections)
	disconnectAll(boss.MovesConnections)

	if boss.Tweens then
		for key, tween in pairs(boss.Tweens) do
			pcall(function() tween:Cancel() end)
			boss.Tweens[key] = nil
		end
	end
	if boss.Cache then
		for key, inst in pairs(boss.Cache) do
			if typeof(inst) == "Instance" then
				pcall(function() inst:Destroy() end)
			end
			boss.Cache[key] = nil
		end
	end

	if boss.Common and boss.States and boss.States.Hitbox then
		pcall(function() boss.Common:ToggleHitbox(boss.States.Hitbox, false) end)
	end
	if boss.States and boss.States.Move and boss.States.Move.cancel then
		pcall(function() boss.States.Move.cancel:Destroy() end)
	end
	if boss.moveCancel then
		pcall(function() boss.moveCancel:Destroy() end)
	end
	if boss.States then
		boss.States.Hitbox = nil
		boss.States.Move = nil
		boss.States.UsingMove = false
	end

	local tempPart = workspace:FindFirstChild("TempPart")
	if tempPart then
		for _, obj in ipairs(tempPart:GetChildren()) do
			if obj:GetAttribute("ZProjectile") then
				pcall(function() obj:Destroy() end)
			end
		end
	end
	if boss.Cooldowns then
		for key in pairs(boss.Cooldowns) do
			boss.Cooldowns[key] = nil
		end
	end
end

-- Zenithega-specific: set health through the real damage pipeline (see prior notes --
-- writing boss.Health directly desyncs SecondPhaseActive/FinalPhaseActive from the
-- actual value, and the next real hit snaps it back up to the phase floor).
local function setZenithegaHealth(boss, target)
	local current = boss.Health
	local max = boss.MaxHealth or 70000
	target = math.clamp(math.floor(target), 0, max)
	local delta = current - target
	if delta == 0 then return current, current end

	if delta > 0 then
		local mult = boss.DamageMultiplier
		if not mult or mult == 0 then mult = 1 end
		boss:TakeDamage(delta / mult, nil, nil, nil, true)
	else
		boss:TakeDamage(delta, nil, nil, nil, true)
	end
	return current, boss.Health
end

local function killZenithega(boss)
	local before = boss.Health
	forceStopAttacks(boss)
	boss.CannotTakeDamage = nil
	boss.SecondPhaseActive = true
	boss.FinalPhaseActive = true
	boss.Health = 0
	if boss.healthBar and boss.healthBar.Bar then
		boss.healthBar.Bar.Size = UDim2.fromScale(0, 1)
	end
	if not boss.Dead then
		boss.Dead = true
		task.spawn(boss.Kill, boss)
	end
	return before
end

