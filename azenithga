-- Makes any hit -- including instant-kill hazards like spikes -- deal 0 net damage.
-- The first version of this only reacted to HealthChanged, which doesn't actually work
-- against instant-kill hits: once a Humanoid's Health hits 0 it transitions into the
-- Dead state *immediately*, and that transition can't be undone just by setting Health
-- back up afterward -- Dead is a one-way door in Roblox. So this version disables the
-- Dead state on the Humanoid outright (SetStateEnabled(Dead, false)), which stops it
-- from ever entering that terminal state no matter how the damage/kill is delivered,
-- and keeps pinning Health to max as a backup for anything that reads Health directly
-- (health bars, phase logic, etc).
local zInvincibleOn = false
local zInvincibleConn = nil

local function hookInvincibility(hum)
	if zInvincibleConn then
		zInvincibleConn:Disconnect()
		zInvincibleConn = nil
	end
	if not hum then return end

	hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
	hum.BreakJointsOnDeath = false

	zInvincibleConn = hum.HealthChanged:Connect(function(newHealth)
		if zInvincibleOn and newHealth < hum.MaxHealth then
			hum.Health = hum.MaxHealth
		end
	end)
end

local function setInvincibilityState(hum, on)
	if not hum then return end
	if on then
		hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
		hum.BreakJointsOnDeath = false
		hum.Health = hum.MaxHealth
	else
		hum:SetStateEnabled(Enum.HumanoidStateType.Dead, true)
		hum.BreakJointsOnDeath = true
	end
end

zInvincible.MouseButton1Click:Connect(function()
	zInvincibleOn = not zInvincibleOn
	zInvincible.Text = zInvincibleOn and "Invincible: ON" or "Invincible: OFF"
	local hum = getHumanoid()
	if hum then
		hookInvincibility(hum)
		setInvincibilityState(hum, zInvincibleOn)
	end
	zStatus.Text = zInvincibleOn
		and "Fully invincible: Dead state disabled, Health pinned. Spikes/instant-kills can't kill you now."
		or "Invincibility off."
end)

-- Humanoid gets replaced on every respawn, so re-hook + re-apply each time.
player.CharacterAdded:Connect(function(char)
	if not zInvincibleOn then return end
	local hum = char:WaitForChild("Humanoid")
	hookInvincibility(hum)
	setInvincibilityState(hum, true)
end)

