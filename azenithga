--============================================================

task.spawn(function()
	while gui.Parent do
		local zBoss = requireBoss(BOSS_DEFS[1])
		if zBoss then
			local phase = "1"
			if zBoss.FinalPhaseActive then phase = "3"
			elseif zBoss.SecondPhaseActive then phase = "2" end
			zLive.Text = ("HP: %d / %d  |  Phase: %s"):format(
				math.floor(zBoss.Health or 0), zBoss.MaxHealth or 0, phase)
		else
			zLive.Text = "Boss not loaded."
		end

		local sBoss = requireBoss(BOSS_DEFS[2])
		if sBoss and sBoss.States then
			sStatus.Text = "Defeated: " .. tostring(sBoss.States.Defeated)
		end

		task.wait(0.5)
	end
end)
