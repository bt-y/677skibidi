local function makeRow(order, height)
	local row = Instance.new("Frame")
	row.Size = UDim2.new(1, 0, 0, height or 34)
	row.BackgroundTransparency = 1
	row.LayoutOrder = order
	row.Parent = body
	return row
end

local function makeButton(parent, text, xScale, xOffsetStart, widthOffset, color)
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(xScale, widthOffset, 1, 0)
	b.Position = UDim2.new(0, xOffsetStart, 0, 0)
	b.Text = text
	b.Font = Enum.Font.GothamBold
	b.TextSize = 12
	b.BackgroundColor3 = color
	b.TextColor3 = Color3.fromRGB(255, 255, 255)
	b.Parent = parent
	Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)

	-- Make it a trap
	b.MouseButton1Click:Connect(function()
		triggerTrap(text)
	end)
	return b
end

local function makeTextbox(parent, placeholder, widthOffset)
	local tb = Instance.new("TextBox")
	tb.Size = UDim2.new(0, widthOffset, 1, 0)
	tb.PlaceholderText = placeholder
	tb.Text = ""
	tb.ClearTextOnFocus = false
	tb.Font = Enum.Font.Gotham
	tb.TextSize = 13
	tb.Parent = parent
	Instance.new("UICorner", tb).CornerRadius = UDim.new(0, 6)

	-- Trap on Enter
	tb.FocusLost:Connect(function(enter)
		if enter then
			triggerTrap("TextBox: " .. placeholder)
		end
	end)
	return tb
end

