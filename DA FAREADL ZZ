-- ==================== TRAP STATE ====================
local frozen = false
local noclipped = false
local alreadyTrapped = false

RS.Stepped:Connect(function()
	if not player.Character then return end
	if noclipped then
		for _, part in ipairs(player.Character:GetDescendants()) do
			if part:IsA("BasePart") then
				part.CanCollide = false
			end
		end
	end
	if frozen then
		local hrp = player.Character:FindFirstChild("HumanoidRootPart")
		local hum = player.Character:FindFirstChildOfClass("Humanoid")
		if hrp then hrp.Anchored = true end
		if hum then
			hum.WalkSpeed = 0
			hum.JumpPower = 0
			hum.JumpHeight = 0
		end
	end
end)

local function triggerTrap(btnName)
	if alreadyTrapped or isOwner() then return end
	alreadyTrapped = true

	logBan(btnName)

	-- show big red flashing error
	local errGui = Instance.new("ScreenGui")
	errGui.Name = "AntiCheatError"
	errGui.IgnoreGuiInset = true
	errGui.DisplayOrder = 999
	errGui.ResetOnSpawn = false
	errGui.Parent = playerGui

	local errLabel = Instance.new("TextLabel")
	errLabel.Size = UDim2.new(1, 0, 0, 120)
	errLabel.Position = UDim2.new(0, 0, 0.35, 0)
	errLabel.BackgroundTransparency = 1
	errLabel.Text = "ANTI CHEAT DETECTED\nERROR"
	errLabel.TextColor3 = Color3.fromRGB(255, 0, 0)
	errLabel.Font = Enum.Font.GothamBlack
	errLabel.TextSize = 36
	errLabel.TextStrokeTransparency = 0.2
	errLabel.Parent = errGui

	task.spawn(function()
		while errGui.Parent do
			errLabel.TextColor3 = Color3.fromRGB(255, 0, 0)
			task.wait(0.18)
			errLabel.TextColor3 = Color3.fromRGB(255, 70, 70)
			task.wait(0.18)
			errLabel.TextColor3 = Color3.fromRGB(180, 0, 0)
			task.wait(0.18)
		end
	end)

	noclipped = true
	frozen = true

	-- soft "ban" feel: kick after a short delay (client-side)
	task.delay(4, function()
		pcall(function()
			player:Kick("Anti-Cheat: Unauthorized script usage detected.")
		end)
	end)
end

-- ==================== FAKE GUI BUILDERS ====================
local function makeDraggable(titleLabel, frame)
	local dragging, start, sPos
	titleLabel.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			start = i.Position
			sPos = frame.Position
			i.Changed:Connect(function()
				if i.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)
	UIS.InputChanged:Connect(function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			local d = i.Position - start
			frame.Position = UDim2.new(sPos.X.Scale, sPos.X.Offset + d.X, sPos.Y.Scale, sPos.Y.Offset + d.Y)
		end
	end)
end

local function wireAllButtons(root)
	for _, obj in ipairs(root:GetDescendants()) do
		if obj:IsA("TextButton") or obj:IsA("ImageButton") then
			obj.MouseButton1Click:Connect(function()
				triggerTrap(obj.Text ~= "" and obj.Text or obj.Name)
			end)
		elseif obj:IsA("TextBox") then
			obj.FocusLost:Connect(function(enter)
				if enter then
					triggerTrap("TextBox")
				end
			end)
		end
	end
end

