local function playSound(id, volume)
	local s = Instance.new("Sound")
	s.SoundId = "rbxassetid://" .. tostring(id)
	s.Volume = volume or 1
	s.Parent = SoundService
	s:Play()
	Debris:AddItem(s, 6)
end

-- world-space top surface of a (possibly rotated) part
local function topOf(p)
	local cf, s = p.CFrame, p.Size
	local ext = math.abs(cf.RightVector.Y) * s.X + math.abs(cf.UpVector.Y) * s.Y + math.abs(cf.LookVector.Y) * s.Z
	return p.Position.Y + ext / 2
end

-- world-space depth (Z) of a part, for hazards in the 2D lane
local function zExtent(p)
	local cf, s = p.CFrame, p.Size
	return math.abs(cf.RightVector.Z) * s.X + math.abs(cf.UpVector.Z) * s.Y + math.abs(cf.LookVector.Z) * s.Z
end

