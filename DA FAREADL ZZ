local function bindNumber(box, key, min, onChange)
	box.FocusLost:Connect(function()
		local n = tonumber(box.Text)
		if n then
			CFG[key] = math.max(min, math.floor(n))
			box.Text = tostring(CFG[key])
			if onChange then onChange() end
		else
			box.Text = tostring(CFG[key])
		end
	end)
end

bindNumber(hpBox, "SagatMaxHealth", 1, function()
	if Session and not Session.over then
		Session.maxHp = CFG.SagatMaxHealth
		Session.hp = Session.maxHp
		Session.updateHud()
	end
end)
bindNumber(sagatDmgBox, "SagatDamage", 0)
bindNumber(zenDmgBox, "ZenithegaDamage", 0)

local function setEnabled(on)
	Enabled = on
	toggleButton.Text = on and "Brawl: ON" or "Brawl: OFF"
	toggleButton.BackgroundColor3 = on and Orange or Dark
	if on then
		setStatus("Armed - Sagat joins once the Zenithega fight is running")
	else
		if Session then endSession() end
		setStatus("Off")
	end
end

toggleButton.MouseButton1Click:Connect(function()
	setEnabled(not Enabled)
end)

healButton.MouseButton1Click:Connect(function()
	if Session and Session.alive and not Session.dead and not Session.over then
		Session.hp = Session.maxHp
		Session.updateHud()
	end
end)

stopButton.MouseButton1Click:Connect(function()
	if Session then
		Finished = true -- don't restart until this fight ends
		endSession()
		setStatus("Brawl ended - you have control again")
	end
end)

leaveButton.MouseButton1Click:Connect(function()
	if Session then
		Finished = true
		endSession()
	end
	local c = LP.Character
	local h = c and c:FindFirstChildOfClass("Humanoid")
	if h then h.Health = 0 end
end)

local function destroyAll()
	running = false
	Enabled = false
	endSession()
	if HealthLock then
		task.spawn(function()
			while HealthLock and fightIsRunning(getBoss()) do task.wait(0.5) end
			unlockHealth()
		end)
	end
	for _, c in ipairs(dragConns) do pcall(function() c:Disconnect() end) end
	pcall(function() Gui:Destroy() end)
	_G.BossBrawl = nil
end

Close.MouseButton1Click:Connect(destroyAll)

_G.BossBrawl = {
	Enable = function() setEnabled(true) end,
	Disable = function() setEnabled(false) end,
	Config = CFG,
	Destroy = destroyAll,
	GetSession = function() return Session end,
}

