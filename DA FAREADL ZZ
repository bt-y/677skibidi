	b.Position = UDim2.new(0, 12, 0, y)
	b.BackgroundColor3 = color
	b.Text = text
	b.TextColor3 = Color3.fromRGB(245, 235, 255)
	b.Font = Enum.Font.GothamMedium
	b.TextSize = 12
	b.Parent = Panel
	Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
