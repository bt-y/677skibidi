-- Is a Zenithega fight running right now (intro done)?
local function fightIsRunning(boss)
	if not boss then return false end
	local zone = boss.zenithega_zone
	local part = boss.Zenithega
	return GameShared.inBattle == true
		and zone ~= nil and zone.Parent ~= nil
		and part ~= nil and part.Parent ~= nil and part.Parent.Name == "BossFight"
		and boss.IntroFinished == true
end

--// Brawl session
local Session = nil
local Starting = false
local Enabled = false
local Finished = false -- a brawl already ran during the current fight
local setStatus = function() end

--// Zenithega's real health: while a brawl fight is on, only Sagat's hits get through.
--// The lock stays until that fight ends, so a fight that had a brawl can't be cleared
--// off the back of Sagat's damage.
local HealthLock = nil -- { boss = <boss>, orig = <original TakeDamage> }

local function lockHealth(boss)
	if HealthLock then return end
	-- the original is kept on the boss itself so re-running the script never loses it
	local orig = rawget(boss, "__BrawlOrigTakeDamage") or boss.TakeDamage
	boss.__BrawlOrigTakeDamage = orig
	HealthLock = { boss = boss, orig = orig }
	boss.TakeDamage = function() end
end

-- After Sagat wins she is frozen in her defeat pose until the fight ends. Her real
-- defeat routine (which reports the stage clear) is never run.
local FrozenConn = nil
local FrozenBoss = nil

local function freezeBoss(boss)
	if FrozenConn then return end
	FrozenBoss = boss
	pcall(function()
		if boss.States.Move and boss.States.Move.cancel then boss.States.Move.cancel:Destroy() end
	end)
	pcall(function()
		if boss.moveCancel then boss.moveCancel:Destroy() end
	end)
	local tp = workspace:FindFirstChild("TempPart")
	if tp then
		for _, c in ipairs(tp:GetChildren()) do
			if c:GetAttribute("ZProjectile") then pcall(game.Destroy, c) end
		end
	end
	FrozenConn = RunService.Heartbeat:Connect(function()
		boss.disabled = true
		boss.canMove = false
		boss.canTeleport = false
	end)
end

local function unfreezeBoss()
	if FrozenConn then
		FrozenConn:Disconnect()
		FrozenConn = nil
	end
	if FrozenBoss then
		FrozenBoss.disabled = false
		FrozenBoss.canMove = true
		FrozenBoss.canTeleport = true
		FrozenBoss = nil
	end
end

local function unlockHealth()
	unfreezeBoss()
	if not HealthLock then return end
	local boss = HealthLock.boss
	boss.TakeDamage = HealthLock.orig
	boss.__BrawlOrigTakeDamage = nil
	HealthLock = nil
end

local function endSession()
	local S = Session
	if not S then return end
	Session = nil
	S.alive = false
	for _, c in ipairs(S.conns) do
		pcall(function() c:Disconnect() end)
	end
	if S.thread then
		pcall(task.cancel, S.thread)
	end
	for i = #S.restore, 1, -1 do
		pcall(S.restore[i])
	end
	if S.anim then
		pcall(function() S.anim:Stop() end)
		pcall(function() S.anim:Destroy() end)
	end
	if S.fx then pcall(function() S.fx:Destroy() end) end
	if S.hud then pcall(function() S.hud:Destroy() end) end
	if not S.resultText then
		setStatus(Enabled and "Armed - waiting for the Zenithega fight" or "Off")
	end
end

local function createSession(boss, module)
	local zone = boss.zenithega_zone
	local zenPart = boss.Zenithega
	local objects = module:FindFirstChild("Objects")
	if not (zone and zenPart and objects and objects:FindFirstChild("Sagat")) then
		return nil, "Missing arena / Sagat assets"
	end

	local ZC = getZenithegaClass()
	local S = {
		alive = true, dead = false, over = false, busy = false,
		boss = boss, conns = {}, restore = {}, projectiles = {},
		waveHit = setmetatable({}, { __mode = "k" }),
		vy = 0, vz = 0, pose = nil, faceLeft = false, lastHurtSound = 0, lastHurt = 0,
	}

	--// arena numbers
	local playerSpawn = zone:FindFirstChild("PlayerSpawn")
	local zenSpawn = zone:FindFirstChild("ZenithegaSpawn")
	local left, right = zone:FindFirstChild("Left"), zone:FindFirstChild("Right")
	local floorPart = zone:FindFirstChild("floor_maphitbox")
	local halfHeight = objects.Sagat.Size.Y / 2

	S.planeX = (playerSpawn or zenSpawn or zenPart).Position.X
	S.minZ = (left and left.Position.Z or zenPart.Position.Z - 70) + 4
	S.maxZ = (right and right.Position.Z or zenPart.Position.Z + 70) - 4
	if floorPart then
		S.floorY = topOf(floorPart)
	elseif playerSpawn then
		S.floorY = playerSpawn.Position.Y - 3.7
	else
		S.floorY = -9
	end
	S.groundY = S.floorY + halfHeight
	S.y = S.groundY -- spawn standing on the floor
	S.z = math.clamp(playerSpawn and playerSpawn.Position.Z or (S.minZ + 18), S.minZ, S.maxZ)
	S.grounded = true
	S.maxHp = CFG.SagatMaxHealth
	S.hp = S.maxHp
	S.zMaxHp = boss.MaxHealth or 110000
	S.zHp = boss.Health or S.zMaxHp

	-- preload Sagat's projectile images so they never show up blank
	task.spawn(function()
		local list = {}
		for _, n in ipairs({ "TigerShot", "OmegaShot", "SanicShot" }) do
			local t = objects:FindFirstChild(n)
			if t then list[#list + 1] = t end
		end
		pcall(function() game:GetService("ContentProvider"):PreloadAsync(list) end)
	end)

	--// containers
	S.fx = Instance.new("Folder")
	S.fx.Name = "BossBrawlFX"
	S.fx.Parent = workspace

	--// Sagat sprite part
	local part = objects.Sagat:Clone()
	part.Name = "BrawlSagat"
	for _, child in ipairs(part:GetChildren()) do
		if child:IsA("Sound") then child:Destroy() end
	end
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CFrame = CFrame.new(S.planeX - 2, S.y, S.z) * CFrame.Angles(0, math.pi / 2, 0)
	part.Parent = S.fx
	S.part = part

	local label = part.SurfaceGui.ImageLabel
	label.Visible = true
	label.ImageTransparency = 0
	label.ImageColor3 = Color3.new(1, 1, 1)

	local anim = ZC.Animator.New({
		Signature = "BossBrawlSagat_" .. tostring(math.floor(os.clock() * 1000)),
		FPS = BASE_FPS,
		Parent = label,
		Size = Vector2.new(192, 148),
	})
	S.anim = anim

	for _, name in ipairs(SPRITES) do
		pcall(function()
			anim:LoadBufferFromBaked({ AnimationSignature = name, Type = "Sprites" })
		end)
	end

	local loadStart = os.clock()
	repeat
		local ready = true
		for _, name in ipairs(SPRITES) do
			local store = anim.Storages.Sprites[name]
			if not store or #store == 0 then ready = false break end
		end
		if ready then break end
		task.wait(0.1)
	until os.clock() - loadStart > 20 or not S.alive

	--// helpers
	local function setPose(name, force)
		local def = POSE[name]
		if not def then return end
		if S.pose == name and not force then return end
		S.pose = name
		local ok = pcall(function()
			anim:Stop()
			anim:Play({
				AnimationSignature = def.sig, Type = "Sprites",
				Once = not def.loop, FPS = def.fps, FrameTime = def.ft,
			})
		end)
		if not ok then
			pcall(function()
				anim:Play({ AnimationSignature = def.sig, Type = "Sprites", Once = not def.loop, FPS = def.fps })
			end)
		end
	end

	local function stopped()
		return (not S.alive) or S.dead or S.over
	end

	-- a charged counter is the only thing allowed to cut an attack short
	local function mustCounter()
		return (S.counterPending and not S.countering) or (S.evadePending and not S.evading)
			or (S.beamPending and not S.beamDodging)
			or (S.climbPending and not S.climbing)
			or (S.fruitPending and not S.fruiting)
	end

	local function sleep(t)
		local t0 = os.clock()
		while os.clock() - t0 < t do
			if stopped() or mustCounter() then return false end
			task.wait()
		end
		return not stopped() and not mustCounter()
	end

	local function zenPos()
		local p = zenPart.Position
		return p.Y, p.Z
	end

	local zenLabel = zenPart:FindFirstChild("SurfaceGui") and zenPart.SurfaceGui:FindFirstChild("ImageLabel")

	local function zenTangible()
		if zenPart.Parent == nil then return false end
		return (not zenLabel) or zenLabel.ImageTransparency < 0.9
	end

	local function faceTarget()
		local _, tz = zenPos()
		S.faceLeft = tz < S.z
	end

	local function dirSign()
		return S.faceLeft and -1 or 1
	end

	--// HUD: Sagat bar + Zenithega brawl bar
	local hud = Instance.new("ScreenGui")
	hud.Name = "BossBrawlHUD"
	hud.ResetOnSpawn = false
	hud.DisplayOrder = 20
	hud.Parent = PlayerGui
	S.hud = hud

	local function makeBar(y, strokeColor, trackColor, fillColor)
		local holder = Instance.new("Frame")
		holder.AnchorPoint = Vector2.new(0.5, 0)
		holder.Position = UDim2.new(0.5, 0, 0, y)
		holder.Size = UDim2.new(0, 360, 0, 28)
		holder.BackgroundColor3 = Color3.fromRGB(18, 16, 24)
		holder.BackgroundTransparency = 0.1
		holder.BorderSizePixel = 0
		holder.Parent = hud
		Instance.new("UICorner", holder).CornerRadius = UDim.new(0, 8)
		local stroke = Instance.new("UIStroke", holder)
		stroke.Color = strokeColor
		stroke.Transparency = 0.4

		local track = Instance.new("Frame")
		track.Size = UDim2.new(1, -8, 1, -8)
		track.Position = UDim2.new(0, 4, 0, 4)
		track.BackgroundColor3 = trackColor
		track.BorderSizePixel = 0
		track.Parent = holder
		Instance.new("UICorner", track).CornerRadius = UDim.new(0, 5)

		local fill = Instance.new("Frame")
		fill.Size = UDim2.new(1, 0, 1, 0)
		fill.BackgroundColor3 = fillColor
		fill.BorderSizePixel = 0
		fill.Parent = track
		Instance.new("UICorner", fill).CornerRadius = UDim.new(0, 5)

		local text = Instance.new("TextLabel")
		text.Size = UDim2.new(1, 0, 1, 0)
		text.BackgroundTransparency = 1
		text.TextColor3 = Color3.new(1, 1, 1)
		text.Font = Enum.Font.GothamBold
		text.TextSize = 13
		text.ZIndex = 3
		text.Parent = track
		return fill, text
	end

	-- Zenithega's own health bar on screen; her real TakeDamage updates it
	local realBar = boss.healthBar and boss.healthBar:FindFirstChild("Bar")

	local sFill, sText = makeBar(72, Color3.fromRGB(255, 140, 60), Color3.fromRGB(60, 20, 20), Color3.fromRGB(255, 120, 40))
	local zFill, zText
	if not realBar then
		-- fallback only if her bar can't be found
		zFill, zText = makeBar(106, Color3.fromRGB(150, 110, 255), Color3.fromRGB(30, 20, 60), Color3.fromRGB(140, 90, 255))
	end

	local resultLabel = Instance.new("TextLabel")
	resultLabel.AnchorPoint = Vector2.new(0.5, 0)
	resultLabel.Position = UDim2.new(0.5, 0, 0, 142)
	resultLabel.Size = UDim2.new(0, 420, 0, 40)
	resultLabel.BackgroundTransparency = 1
	resultLabel.TextColor3 = Color3.fromRGB(255, 230, 140)
	resultLabel.TextStrokeTransparency = 0.3
	resultLabel.Font = Enum.Font.GothamBlack
	resultLabel.TextSize = 28
	resultLabel.Text = ""
	resultLabel.Parent = hud

	local function updateHud()
		sFill.Size = UDim2.new(math.clamp(S.hp / S.maxHp, 0, 1), 0, 1, 0)
		sText.Text = string.format("SAGAT   %d / %d", math.ceil(S.hp), S.maxHp)
		S.zHp = boss.Health or S.zHp
		if zFill then
			zFill.Size = UDim2.new(math.clamp(S.zHp / S.zMaxHp, 0, 1), 0, 1, 0)
			zText.Text = string.format("ZENITHEGA   %d / %d", math.ceil(S.zHp), S.zMaxHp)
		end
	end
	updateHud()
	S.updateHud = updateHud

	--// result
	local function finish(winner)
		if S.over then return end
		S.over = true
		S.busy = false
		S.vz = 0
		S.gravScale = 1
		S.counterPending = false
		S.evadePending = false
		S.beamPending = false
		S.crouching = false
		S.climbPending = false
		S.fruitPending = false
		local endDelay = 4
		if winner == "Sagat" then
			S.resultText = "SAGAT WINS"
			endDelay = 8
			task.spawn(function() pcall(S.zenithegaDefeat) end)
			task.spawn(function() pcall(S.walkHome) end)
		else
			S.resultText = "ZENITHEGA WINS"
		end
		resultLabel.Text = S.resultText
		setStatus(S.resultText .. " - you get control back in " .. endDelay .. "s")
		task.delay(endDelay, function()
			if Session == S then
				Finished = true
				endSession()
				setStatus(S.resultText .. " (brawl over for this fight)")
			end
		end)
	end

	--// damage in both directions
	local function flash(target)
		if not target then return end
		target.ImageColor3 = Color3.fromRGB(255, 110, 110)
		task.delay(0.08, function()
			if target.ImageColor3 == Color3.fromRGB(255, 110, 110) then
				target.ImageColor3 = Color3.new(1, 1, 1)
			end
		end)
	end

	local function die()
		S.dead = true
		S.vz = 0
		S.busy = false
		setPose("Death", true)
		playSound(SOUND.KO, 1.2)
		task.delay(2.5, function()
			if S.alive then
				TweenService:Create(label, TweenInfo.new(1.5), { ImageTransparency = 1 }):Play()
			end
		end)
		finish("Zenithega")
	end

	-- one Zenithega hit on Sagat (shared by every detection path, with i-frames)
	local function hurtSagat(dmg)
		if S.dead or S.over or not S.alive then return end
		local now = os.clock()
		if now - S.lastHurt < CFG.HitCooldown then return end
		S.lastHurt = now
		S.hp = math.max(0, S.hp - dmg)
		updateHud()
		flash(label)
		if now - S.lastHurtSound > 0.2 then
			S.lastHurtSound = now
			playSound(SOUND.DAMAGED, 0.5)
		end
		if S.hp <= 0 then
			die()
		elseif not S.busy and S.grounded then
			setPose("Damaged", true)
		end
	end
	S.hurtSagat = hurtSagat

	-- Sagat hit on Zenithega: real damage through her own TakeDamage, so her health,
	-- her bar, phase 2 and the final phase all happen normally. The only thing blocked
	-- is the killing blow: when a final-phase hit would finish her, Sagat wins instead
	-- and she is left alive.
	local FINISH_HP = 1
	local function damageZenithega(dmg)
		if S.over or not HealthLock then return false end
		if boss.Dead or boss.CannotTakeDamage then return false end -- phase change in progress
		if type(boss.Shield) == "table" and not boss.Shield.Dead then return false end -- shielded
		local health = boss.Health or 0
		if boss.FinalPhaseActive and health - dmg <= FINISH_HP then
			finish("Sagat")
			return true
		end
		local mult = boss.DamageMultiplier
		if not mult or mult == 0 then mult = 1 end
		local combo = boss.hitCombo
		boss.hitCombo = nil -- keep your combo counter out of it
		pcall(HealthLock.orig, boss, dmg / mult, nil, nil, nil, true)
		boss.hitCombo = combo
		updateHud()
		flash(zenLabel)
		return true
	end

	--// Your character disappears and rides inside Sagat, so everything Zenithega
	--// aims at "you" goes to him. You can't be hurt and get control back afterwards.
	local char = LP.Character
