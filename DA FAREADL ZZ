	-- anything that lowers your health during the brawl becomes a hit on Sagat
	S.conns[#S.conns + 1] = hum.HealthChanged:Connect(function(h)
		if not S.alive or S.over then return end
		if h > 0 and h < hum.MaxHealth then
			hurtSagat(CFG.ZenithegaDamage)
			hum.Health = hum.MaxHealth
		end
	end)

	--// Hook: hits aimed at your character go to Sagat instead
	local DS = getDamageService()
	local origDeal = DS.DealDamage
	DS.DealDamage = function(self, targets, info, ...)
		if Session == S and S.alive and not S.over then
			local c = LP.Character
			if c then
				if typeof(targets) == "Instance" then
					if targets == c then
						hurtSagat(CFG.ZenithegaDamage)
						return true
					end
				elseif type(targets) == "table" and table.find(targets, c) then
					local rest = {}
					for _, t in ipairs(targets) do
						if t ~= c then rest[#rest + 1] = t end
					end
					hurtSagat(CFG.ZenithegaDamage)
					if #rest == 0 then return true end
					return origDeal(self, rest, info, ...)
				end
			end
		end
		return origDeal(self, targets, info, ...)
	end
	S.restore[#S.restore + 1] = function()
		if DS.DealDamage ~= origDeal then
			DS.DealDamage = origDeal
		end
	end

	--// Her real health: only Sagat's hits from here until this fight ends
	lockHealth(boss)

	--// projectiles
	local function spawnProjectile(kind, y, z, vy, vz, life, gravity)
		local def = PROJECTILE[kind]
		local template = objects:FindFirstChild(def.template)
		if not template then return nil end
		local p = template:Clone()
		p.Anchored = true
		p.CanCollide = false
		p.CanTouch = false
		p.CanQuery = false
		p.CastShadow = false
		p.Parent = S.fx
		local sg = p:FindFirstChildOfClass("SurfaceGui")
		if sg then
			sg.Enabled = true
			sg.AlwaysOnTop = true -- never hidden behind the arena
			sg.LightInfluence = 0
			sg.Face = Enum.NormalId.Left
			for _, img in ipairs(sg:GetDescendants()) do
				if img:IsA("ImageLabel") then
					img.Visible = true
					img.ImageTransparency = 0
				end
			end
		end
		local proj = {
			part = p, label = sg and sg:FindFirstChildWhichIsA("ImageLabel"), kind = kind,
			y = y, z = z, vy = vy, vz = vz, g = gravity or 0,
			born = os.clock(), life = life, rot = 0, frame = 1, frameAt = os.clock(),
			spin = def.spin and def.spin * (vz >= 0 and 1 or -1) or nil,
		}
		S.projectiles[#S.projectiles + 1] = proj
		return proj
	end

	local function explode(proj)
		proj.dead = true
		if proj.label then
			TweenService:Create(proj.label, TweenInfo.new(0.18), {
				ImageTransparency = 1, Size = UDim2.fromScale(1.8, 1.8),
			}):Play()
		end
		Debris:AddItem(proj.part, 0.25)
	end

	--// Her apples / fruits: models in TempPart with a "hit" event. Any hit shrinks them;
	--// enough hits make them explode (same as your pistol shots).
	S.fruits = {}
	local function findFruits()
		local list = {}
		local tp = workspace:FindFirstChild("TempPart")
		if not tp then return list end
		for _, c in ipairs(tp:GetChildren()) do
			if c:IsA("Model") and c.Name ~= "Wave" and c.PrimaryPart then
				local h = c:FindFirstChild("hit")
				if h and h:IsA("BindableEvent") then list[#list + 1] = c end
			end
		end
		return list
	end
	S.findFruits = findFruits

	local function fruitRadius(m)
		local pp = m.PrimaryPart
		return pp and (pp.Size.Magnitude * 0.35 + 1.5) or 3
	end

	local function fruitAt(y, z)
		for _, f in ipairs(S.fruits) do
			local pp = f.Parent and f.PrimaryPart
			if pp then
				local r = fruitRadius(f)
				if math.abs(pp.Position.Y - y) < r and math.abs(pp.Position.Z - z) < r then return f end
			end
		end
		return nil
	end

	local function hitFruit(f)
		local h = f and f:FindFirstChild("hit")
		if h then
			h:Fire(CFG.SagatDamage, { Damage = CFG.SagatDamage, Type = 1 }, 1, {})
		end
	end

	-- p.homing  = turn rate (rad/s) toward the target
	-- p.target  = function returning the target's y, z (nil when it's gone); default is Zenithega
	-- p.onHit   = what happens on contact with p.target
	local function updateProjectiles(dt)
		local zy, zz = zenPos()
		local tangible = zenTangible()
		for i = #S.projectiles, 1, -1 do
			local p = S.projectiles[i]
			if p.dead or not p.part.Parent then
				table.remove(S.projectiles, i)
			else
				local ty, tz
				if p.target then
					ty, tz = p.target()
				else
					ty, tz = zy, zz
				end
				if p.homing and ty then
					local speed = math.sqrt(p.vy * p.vy + p.vz * p.vz)
					local cur = math.atan2(p.vy, p.vz)
					local want = math.atan2(ty - p.y, tz - p.z)
					local diff = (want - cur + math.pi) % (2 * math.pi) - math.pi
					local step = p.homing * dt
					cur = cur + math.clamp(diff, -step, step)
					p.vy, p.vz = math.sin(cur) * speed, math.cos(cur) * speed
				end
				p.vy = p.vy - p.g * dt
				p.y = p.y + p.vy * dt
				p.z = p.z + p.vz * dt
				local angle
				if p.spin then
					p.rot = p.rot + p.spin * dt
					angle = p.rot
				else
					angle = math.atan2(p.vy, -p.vz)
				end
				p.part.CFrame = CFrame.new(S.planeX - 1.5, p.y, p.z) * CFrame.Angles(angle, 0, 0)
				if p.kind == "Tiger" and p.label and os.clock() - p.frameAt >= 0.1 then
					p.frameAt = os.clock()
					p.frame = p.frame % 2 + 1
					p.label.Image = PROJECTILE.Tiger.frames[p.frame]
				end

				local done = false
				if p.target then
					if not ty then
						done = true -- its target is gone
					elseif math.abs(p.y - ty) < p.hitRadius and math.abs(p.z - tz) < p.hitRadius then
						done = true
						if p.onHit then pcall(p.onHit) end
					end
				elseif fruitAt(p.y, p.z) then
					done = true
					hitFruit(fruitAt(p.y, p.z))
				elseif tangible and not S.over and math.abs(p.y - zy) < 6.2 and math.abs(p.z - zz) < 4.2 then
					done = true
					damageZenithega(CFG.SagatDamage)
				end
				if done or os.clock() - p.born > p.life or p.y < S.floorY - 4 then
					explode(p)
					table.remove(S.projectiles, i)
				end
			end
		end
	end

	--// Fallback: Zenithega objects that hurt by overlap instead of DealDamage
	local overlap = OverlapParams.new()
	overlap.FilterType = Enum.RaycastFilterType.Include

	local function isAttackObject(top, p)
		if top:GetAttribute("ZProjectile") or p:GetAttribute("ZProjectile") then
			return true
		end
		local name = string.lower(top.Name)
		for _, key in ipairs(ATTACK_KEYWORDS) do
			if string.find(name, key, 1, true) then return true end
		end
		return false
	end

	local function scanZenithegaAttacks()
		if S.dead or S.over then return end
		local tempPart = workspace:FindFirstChild("TempPart")
		if not tempPart then return end

		for _, child in ipairs(tempPart:GetChildren()) do
			if child.Name == "Wave" and not S.waveHit[child] then
				local pp = child:IsA("Model") and child.PrimaryPart or (child:IsA("BasePart") and child) or nil
				if pp then
					local dy, dz = S.y - pp.Position.Y, S.z - pp.Position.Z
					local dist = math.sqrt(dy * dy + dz * dz) - pp.Size.X * 0.5
					if dist < 0.5 then
						S.waveHit[child] = true
						hurtSagat(CFG.ZenithegaDamage)
					end
				end
			end
		end

		overlap.FilterDescendantsInstances = { tempPart }
		local parts = workspace:GetPartBoundsInBox(
			CFrame.new(S.planeX, S.y, S.z), Vector3.new(80, 9, 4.5), overlap)
		for _, p in ipairs(parts) do
			local top = p
			while top.Parent and top.Parent ~= tempPart do
				top = top.Parent
			end
			if top.Parent == tempPart and top.Name ~= "Wave" and isAttackObject(top, p) then
				hurtSagat(CFG.ZenithegaDamage)
				if S.dead then return end
			end
		end
	end

	--// Sagat attacks (his own moves, aimed at Zenithega)
	local function aimAt(fromY, fromZ)
		local ty, tz = zenPos()
		local dy, dz = ty - fromY, tz - fromZ
		local len = math.max(math.sqrt(dy * dy + dz * dz), 0.001)
		return dy / len, dz / len, len
	end

	local function fireTiger(spread)
		local sy, sz = S.y + 1.5, S.z + dirSign() * 4.5
		local dy, dz, dist = aimAt(sy, sz)
		local angle = math.atan2(dy, dz) + math.rad(math.random(-spread, spread))
		local speed = 42
		local proj = spawnProjectile("Tiger", sy, sz, math.sin(angle) * speed, math.cos(angle) * speed,
			math.min(dist / speed + 2.5, 6), 0)
		if proj then proj.homing = 3 end
		playSound(SOUND.TIGER, 0.6)
	end

	local function waitLanding(maxTime)
		local t0 = os.clock()
		while not stopped() and not S.grounded and os.clock() - t0 < maxTime do
			task.wait()
		end
	end

	-- every ground attack starts with Sagat standing still on the floor, facing her
	local function plant()
		waitLanding(2)
		S.vz = 0
		faceTarget()
	end

	local function attackTigerShot()
		plant()
		setPose("Tiger", true)
		playSound(SOUND.TIGER)
		if not sleep(0.35) then return end
		for i = 1, math.random(5, 8) do
			if stopped() then return end
			faceTarget()
			if i % 2 == 1 then setPose("Tiger", true) end
			fireTiger(8)
			if not sleep(0.28) then return end
		end
		sleep(0.25)
	end

	local function attackOmegaShot()
		plant()
		playSound(SOUND.OMEGA, 1.5)
		for _ = 1, 4 do
			if stopped() then return end
			faceTarget()
			setPose("Sanic", true)
			if not sleep(0.25) then return end
			local sy, sz = S.y + 1.5, S.z + dirSign() * 4.5
			local dy, dz, dist = aimAt(sy, sz)
			local speed = 38
			local proj = spawnProjectile("Omega", sy, sz, dy * speed, dz * speed, math.min(dist / speed + 2.5, 6), 0)
			if proj then proj.homing = 2.5 end
			if not sleep(0.4) then return end
		end
		sleep(0.25)
	end

	local function attackSanic()
		plant()
		for _ = 1, 3 do
			if stopped() then return end
			faceTarget()
			setPose("Sanic", true)
			if not sleep(0.25) then return end
			local sy, sz = S.y + 1, S.z + dirSign() * 4
			local ty, tz = zenPos()
			local g = 110
			local travel = math.clamp(math.abs(tz - sz) / 45, 0.5, 1.6)
			local vz = (tz - sz) / travel
			local vy = (ty - sy + 0.5 * g * travel * travel) / travel
			playSound(SOUND.SANIC, 0.8)
			spawnProjectile("Sanic", sy, sz, vy, vz, travel + 1.2, g)
			if not sleep(0.45) then return end
		end
		sleep(0.2)
	end

	-- a deliberate jump: crouch, leap, shoot at the top of the jump, land
	local function attackJumpShot()
		plant()
		setPose("Jump", true)
		if not sleep(0.15) then return end
		local _, tz = zenPos()
		S.vz = (tz > S.z and 1 or -1) * CFG.WalkSpeed * 0.5
		S.vy = CFG.JumpPower
		local t0 = os.clock()
		while not stopped() and S.vy > 15 and os.clock() - t0 < 1 do
			task.wait()
		end
		S.vz = 0
		for _ = 1, 3 do
			if stopped() then return end
			faceTarget()
			setPose("Tiger", true)
			fireTiger(5)
			if not sleep(0.12) then return end
		end
		setPose("Fall", true)
		waitLanding(2)
		sleep(0.2)
	end

	local function attackUppercut()
		plant()
		setPose("Walk")
		local t0 = os.clock()
		while os.clock() - t0 < 0.35 and not stopped() do
			local _, tz = zenPos()
			if math.abs(tz - S.z) < 7 then break end
			S.vz = (tz > S.z and 1 or -1) * 60
			task.wait()
		end
		S.vz = 0
		if stopped() then return end
		faceTarget()
		setPose("Uppercut", true)
		playSound(SOUND.UPPERCUT)
		S.vy = 75
		local hitDone = false
		local riseStart = os.clock()
		while not stopped() and (S.vy > 0 or os.clock() - riseStart < 0.25) and os.clock() - riseStart < 1.2 do
			local zy, zz = zenPos()
			if not hitDone and zenTangible()
				and math.abs(zz - (S.z + dirSign() * 3)) < 8
				and math.abs(zy - (S.y + 3)) < 11 then
				hitDone = true
				damageZenithega(CFG.SagatDamage)
			end
			task.wait()
		end
		waitLanding(2)
		sleep(0.3)
	end

	-- she's floating out of reach: leap up to her height, hang there and hit her
	local function attackLeap()
		plant()
		local ty, tz = zenPos()
		local h = math.clamp(ty - S.y, 8, 130)
		setPose("Jump", true)
		if not sleep(0.15) then return end
		S.vy = math.sqrt(2 * CFG.Gravity * h)
		local tApex = S.vy / CFG.Gravity
		S.vz = math.clamp((tz - S.z) / math.max(tApex, 0.3) * 0.85, -70, 70)
		local t0 = os.clock()
		while not stopped() and S.vy > 6 and os.clock() - t0 < 2.5 do
			task.wait()
		end
		S.vz = 0
		if stopped() then return end
		S.gravScale = 0.12 -- hang in the air for the combo
		local zy, zz = zenPos()
		if math.abs(zz - S.z) < 10 and math.abs(zy - S.y) < 10 then
			faceTarget()
			setPose("Uppercut", true)
			playSound(SOUND.UPPERCUT)
			damageZenithega(CFG.SagatDamage)
			sleep(0.2)
		end
		for _ = 1, 4 do
			if stopped() then break end
			faceTarget()
			setPose("Tiger", true)
			fireTiger(3)
			if not sleep(0.12) then break end
		end
		S.gravScale = 1
		setPose("Fall", true)
		waitLanding(3)
		sleep(0.2)
	end

	--// Charged counters: the same "charged hit" your pistol / javelin / GGCC deliver.
	--// It stops Death, Heaven's Wrath, her heal, breaks her shield, swords and Zundamon.
	local COUNTER_MOVES = {
		["Heaven's Wrath"] = true, ["Heaven's Wrath (Final)"] = true,
		["Heal (Final Phase)"] = true, ["Shield"] = true, ["Shield (Final)"] = true,
		["Swords"] = true, -- only a charged hit on her ends it; otherwise a finisher kills you
	}
	-- objects she spawns that a charged hit destroys / stops (Death, swords, Zundamon)
	local COUNTER_PARTS = { Death = true, breakhitbox = true, hitbox = true }
	S.counterHits = setmetatable({}, { __mode = "k" })

	local function findCounterTargets()
		local list = {}
		local tempPart = workspace:FindFirstChild("TempPart")
		if tempPart then
			for _, d in ipairs(tempPart:GetDescendants()) do
				if d:IsA("BindableEvent") and d.Name == "hit" and d.Parent and d.Parent:IsA("BasePart")
					and COUNTER_PARTS[d.Parent.Name] and (S.counterHits[d] or 0) < 4 then
					list[#list + 1] = { event = d, part = d.Parent, urgent = true }
				end
			end
		end
		local hb = zenPart:FindFirstChild("Hitbox")
		local zenHit = hb and hb:FindFirstChild("hit")
		if zenHit then
			local urgent = false
			local ok, active = pcall(boss.ReturnActiveMoves, boss)
			if ok and type(active) == "table" then
				for _, mv in ipairs(active) do
					if COUNTER_MOVES[mv.name] and not string.find(mv.name, "Shield", 1, true) then
						urgent = true
						break
					end
				end
			end
			local shielded = type(boss.Shield) == "table" and not boss.Shield.Dead
			if urgent or shielded then
				-- hitting her comes first: it ends the whole attack (swords keep coming otherwise)
				table.insert(list, 1, { event = zenHit, part = zenPart, isZen = true, urgent = urgent })
			end
		end
		return list
	end
	S.findCounterTargets = findCounterTargets

	local function fireCharged(t)
		local sy, sz = S.y + 1.5, S.z + dirSign() * 4.5
		local tp = t.part.Position
		local dy, dz = tp.Y - sy, tp.Z - sz
		local len = math.max(math.sqrt(dy * dy + dz * dz), 0.001)
		local speed = 60
		local proj = spawnProjectile("Omega", sy, sz, dy / len * speed, dz / len * speed, 4, 0)
		if not proj then return end
		pcall(function() proj.part.Size = proj.part.Size * 1.6 end)
		if proj.label then proj.label.ImageColor3 = Color3.fromRGB(255, 220, 90) end
		proj.homing = 12
		proj.hitRadius = 4 + math.min(t.part.Size.Magnitude * 0.25, 6)
		proj.target = function()
			if t.isZen then
				if not zenPart.Parent then return nil end
			elseif not (t.part.Parent and t.event.Parent) then
				return nil
			end
			local pos = t.part.Position
			return pos.Y, pos.Z
		end
		proj.onHit = function()
			S.counterHits[t.event] = (S.counterHits[t.event] or 0) + 1
			t.event:Fire(CFG.SagatDamage, { Charged = true, Damage = CFG.SagatDamage, Type = 1 }, 1, {})
			if t.isZen then damageZenithega(CFG.SagatDamage) end
		end
		playSound(SOUND.TIGER, 1)
	end

	local function attackCounter()
		S.countering = true
		local shots = 0
		while not stopped() and shots < 8 do
			local targets = findCounterTargets()
			if #targets == 0 then break end
			local t = targets[1]
			S.vz = 0
			S.faceLeft = t.part.Position.Z < S.z
			setPose("Tiger", true)
			label.ImageColor3 = Color3.fromRGB(255, 220, 90) -- charging glow
			playSound(SOUND.OMEGA, 1)
			if not sleep(0.35) then break end
			label.ImageColor3 = Color3.new(1, 1, 1)
			fireCharged(t)
			shots = shots + 1
			if not sleep(0.3) then break end
		end
		label.ImageColor3 = Color3.new(1, 1, 1)
		S.countering = false
		S.counterPending = false
		S.counterCooldown = os.clock() + 0.6
	end

	--// Dodging: jump her dashes and rushes, hop over spikes, run out from under Zangief
	local DASH_MOVES = { ["Super Dash"] = 0.85, ["Jumping Kick"] = 0, ["Crouch Attack"] = 0, ["Destructor"] = 0 }
	S.moveSeen = {}
	local lastZenZ, lastJumpAt = nil, 0

	-- one extra jump in the air normally (double jump); unlimited in her final phase
	local function maxAirJumps()
		return boss.FinalPhaseActive and math.huge or 1
	end

	local function jumpNow(allowAir)
		local now = os.clock()
		if S.grounded then
			if now - lastJumpAt < 0.45 then return end
			S.airJumps = 0
		else
			if not allowAir or now - lastJumpAt < 0.28 then return end
			if (S.airJumps or 0) >= maxAirJumps() then return end
			S.airJumps = (S.airJumps or 0) + 1
		end
		lastJumpAt = now
		S.vy = CFG.JumpPower
		if not S.busy then setPose("Jump", true) end
	end
	S.jumpNow = jumpNow

	local function activeMoveNames()
		local names = {}
		local ok, active = pcall(boss.ReturnActiveMoves, boss)
		if ok and type(active) == "table" then
			for _, mv in ipairs(active) do
				if mv.name then names[mv.name] = true end
			end
		end
		return names
	end

	local function nearestSpike(range)
		local tp = workspace:FindFirstChild("TempPart")
		if not tp then return nil end
		local bestDz, bestGap
		for _, d in ipairs(tp:GetDescendants()) do
			if d:IsA("BasePart") and string.find(string.lower(d.Name), "spike", 1, true)
				and not d:GetAttribute("Broken") and not (d.Parent and d.Parent:GetAttribute("Broken")) then
				-- only spikes that have risen out of the floor
				if topOf(d) > S.floorY + 0.75 and d.Position.Y < S.floorY + 20 then
					local dz = d.Position.Z - S.z
					local gap = math.abs(dz) - zExtent(d) / 2
					if gap < range and (not bestGap or gap < bestGap) then
						bestDz, bestGap = dz, gap
					end
				end
			end
		end
		return bestDz, bestGap
	end

	local function findZangief()
		local zg = workspace:FindFirstChild("Zangeif")
		if zg and zg:IsA("BasePart") then
			return zg, zg:FindFirstChild("destruction hitbox")
		end
	end

	--// Shockwaves: parry them the way you do - the wave checks the parry state the
	--// moment it reaches you, so Sagat raises it just before contact.
	local PARRY_SOUND = 15171252772
	local function doParry()
		if cgs then
			cgs:SetAttribute("parry_state", true)
			task.delay(0.3, function()
				if cgs then cgs:SetAttribute("parry_state", false) end
			end)
		end
		label.ImageColor3 = Color3.fromRGB(120, 200, 255)
		task.delay(0.12, function()
			if label.Parent then label.ImageColor3 = Color3.new(1, 1, 1) end
		end)
		playSound(PARRY_SOUND, 0.8)
		S.parries = (S.parries or 0) + 1
	end

	local function parryWaves()
		local tp = workspace:FindFirstChild("TempPart")
		if not tp or not hrp.Parent then return end
		local hp = hrp.Position
		for _, w in ipairs(tp:GetChildren()) do
			if w.Name == "Wave" and not S.waveHit[w] then
				local pp = w:IsA("Model") and w.PrimaryPart or (w:IsA("BasePart") and w) or nil
				if pp then
					local d = (hp - pp.Position).Magnitude - pp.Size.X / 2
					if d < 3 then
						S.waveHit[w] = true -- parried: the wave doesn't hurt him
						doParry()
					end
				end
			end
		end
	end

	local function dodgeReflex(dt)
		local now = os.clock()
		local zy, zz = zenPos()

		-- 1) her dashes and melee lunges
		local names = activeMoveNames()
		for name, delay in pairs(DASH_MOVES) do
			if names[name] then
				local seen = S.moveSeen[name]
				if not seen then
					seen = { start = now, jumped = false }
					S.moveSeen[name] = seen
				end
				if not seen.jumped then
					local close = math.abs(zz - S.z) < 18 and math.abs(zy - S.y) < 12
					if (delay > 0 and now - seen.start >= delay) or (delay == 0 and close) then
						seen.jumped = true
						jumpNow()
					end
				end
			else
				S.moveSeen[name] = nil
			end
		end

		-- 1b) Master Spark coming
		if names["Obliteration Beam"] and not S.beamDodging and not S.beamPending then
			S.beamPending = true
		end

		-- 2) she rushes at him fast
		if lastZenZ and dt > 0 then
			local speed = (zz - lastZenZ) / dt
			if (S.z - zz) * speed > 0 and math.abs(speed) > 45 and math.abs(zz - S.z) < 25 and math.abs(zy - S.y) < 12 then
				jumpNow()
			end
		end
		lastZenZ = zz

		-- 3) spikes in the floor: hop over the one ahead (or the one under him)
		if S.grounded then
			local dz, gap = nearestSpike(2.5 + math.abs(S.vz) * 0.3)
			if dz and (dz * S.vz > 0 or gap < 1.5) then
				jumpNow()
			end
		end

		-- 5) apples homing in: jump / double jump so they follow him up instead of hitting him
		local nearestD
		for _, f in ipairs(S.fruits) do
			local pp = f.Parent and f.PrimaryPart
			if pp then
				local dy, dz = pp.Position.Y - S.y, pp.Position.Z - S.z
				local d = math.sqrt(dy * dy + dz * dz) - fruitRadius(f)
				if not nearestD or d < nearestD then nearestD = d end
			end
		end
		if nearestD and nearestD < 14 then
			jumpNow(true)
		end
		if #S.fruits > 0 and not S.fruiting and not S.fruitPending then
			S.fruitPending = true
		end

		-- 6) her opening laser (in the starter attack): climb the wall
		if names["Intro"] and S.beamVisible and S.beamVisible() and not S.climbing and not S.climbPending then
			S.climbPending = true
		end

		-- 4) Zangief dropping from the roof: get out from under him
		local zg, hb = findZangief()
		if zg and not S.evading and not S.evadePending then
			local half = zExtent(hb or zg) / 2 + 6
			local gz = zg.Position.Z
			if math.abs(S.z - gz) < half then
				local leftZ, rightZ = gz - half - 2, gz + half + 2
				local leftOk, rightOk = leftZ >= S.minZ, rightZ <= S.maxZ
				local target
				if leftOk and rightOk then
					-- go to the other side from where she is, so he keeps facing her
					target = (zz < gz) and rightZ or leftZ
					if math.abs(target - S.z) > half * 2.5 then
						target = (math.abs(leftZ - S.z) < math.abs(rightZ - S.z)) and leftZ or rightZ
					end
				elseif leftOk then
					target = leftZ
				elseif rightOk then
					target = rightZ
				else
					target = (gz - S.minZ > S.maxZ - gz) and S.minZ or S.maxZ
				end
				S.evadeZ = target
				S.evadePending = true
			end
		end
	end

	--// Master Spark (Obliteration Beam): it fires straight across at her own height.
	--// She's standing on the floor -> low beam -> jump over it (keep double-jumping).
	--// She's floating             -> high beam -> crouch under it.
	local function beamVisible()
		local tp = workspace:FindFirstChild("TempPart")
		if not tp then return false end
		for _, c in ipairs(tp:GetChildren()) do
			if c.Name == "evil" or c.Name == "start" or c.Name == "big_smoke" then return true end
			if c:IsA("BasePart") and math.max(c.Size.X, c.Size.Y, c.Size.Z) > 150 then return true end
		end
		return false
	end

	S.beamVisible = beamVisible

	local function beamActive()
		return activeMoveNames()["Obliteration Beam"] == true or beamVisible()
	end

	local function attackBeamDodge()
		S.beamDodging = true
		S.beamPending = false
		plant()
		setPose("Idle", true)
		local t0 = os.clock()
		-- wait until she has taken her spot and starts charging
		local lastY, lastZ, stillSince = nil, nil, os.clock()
		while not stopped() and beamActive() and os.clock() - t0 < 8 do
			if beamVisible() then break end
			local zy, zz = zenPos()
			if lastY and (math.abs(zy - lastY) > 0.2 or math.abs(zz - lastZ) > 0.2) then stillSince = os.clock() end
			lastY, lastZ = zy, zz
			if os.clock() - t0 > 2.2 and os.clock() - stillSince > 0.4 then break end
			faceTarget()
			task.wait()
		end
		if not stopped() and beamActive() then
			local zy = zenPos()
			local standingY = S.floorY + zenPart.Size.Y / 2
			if zy > standingY + 2.5 then
				-- high beam: duck under it until it's gone
				S.crouching = true
				setPose("Crouch", true)
				while not stopped() and beamActive() and os.clock() - t0 < 14 do
					task.wait()
				end
				S.crouching = false
			else
				-- low beam: double jump over it and keep hopping while it lasts
				local safeY = zy + 14 + halfHeight
				S.vy = CFG.JumpPower
				setPose("Jump", true)
				while not stopped() and beamActive() and os.clock() - t0 < 14 do
					if S.vy < 0 and S.y < safeY then
						S.vy = CFG.JumpPower * 0.9 -- next (double) jump
						setPose("Jump", true)
					end
					task.wait()
				end
				setPose("Fall", true)
				waitLanding(3)
			end
		end
		S.crouching = false
		S.beamDodging = false
	end

	-- shoot her apples down (6 hits each), nearest first
	local function fireAtFruit(m)
		local pp = m.PrimaryPart
		if not pp then return end
		local sy, sz = S.y + 1.5, S.z + dirSign() * 4.5
		local tp = pp.Position
		local dy, dz = tp.Y - sy, tp.Z - sz
		local len = math.max(math.sqrt(dy * dy + dz * dz), 0.001)
		local speed = 60
		local proj = spawnProjectile("Tiger", sy, sz, dy / len * speed, dz / len * speed, 3, 0)
		if not proj then return end
		proj.homing = 9
		proj.hitRadius = fruitRadius(m)
		proj.target = function()
			if m.Parent and m.PrimaryPart then
				local pos = m.PrimaryPart.Position
				return pos.Y, pos.Z
			end
			return nil
		end
		proj.onHit = function() hitFruit(m) end
		playSound(SOUND.TIGER, 0.5)
	end

	local function attackFruits()
		S.fruiting = true
		S.fruitPending = false
		local t0 = os.clock()
		while not stopped() and os.clock() - t0 < 8 do
			local fruits = findFruits()
			if #fruits == 0 then break end
			local best, bestD
			for _, f in ipairs(fruits) do
				local pos = f.PrimaryPart.Position
				local d = math.abs(pos.Y - S.y) + math.abs(pos.Z - S.z)
				if not bestD or d < bestD then best, bestD = f, d end
			end
			S.vz = 0
			S.faceLeft = best.PrimaryPart.Position.Z < S.z
			setPose("Tiger", true)
			fireAtFruit(best)
			if not sleep(0.13) then break end
		end
		S.fruiting = false
	end

	-- opening laser: run to the nearest wall and climb it until the laser is over
	local function attackWallClimb()
		S.climbing = true
		S.climbPending = false
		local wallZ = (math.abs(S.z - S.minZ) <= math.abs(S.z - S.maxZ)) and S.minZ or S.maxZ
		setPose("Walk", true)
		local t0 = os.clock()
		while not stopped() and math.abs(S.z - wallZ) > 0.8 and os.clock() - t0 < 3 do
			S.faceLeft = wallZ < S.z
			S.vz = (wallZ > S.z and 1 or -1) * CFG.WalkSpeed * 1.6
			task.wait()
		end
		S.vz = 0
		local topY = S.floorY + CFG.WallClimbHeight
		local roof = zone:FindFirstChild("roof")
		if roof and roof:IsA("BasePart") then
			topY = math.min(topY, roof.Position.Y - roof.Size.Y / 2 - halfHeight - 2)
		end
		S.gravScale = 0
		setPose("Jump", true)
		while not stopped() and S.y < topY and os.clock() - t0 < 6 do
			S.vy = 32 -- climbing
			task.wait()
		end
		S.vy = 0
		setPose("Idle", true)
		while not stopped() and S.beamVisible() and os.clock() - t0 < 16 do
			S.vy = 0 -- holding on to the wall
			task.wait()
		end
		S.gravScale = 1
		setPose("Fall", true)
		waitLanding(4)
		S.climbing = false
	end

	-- final phase: chase her through the air with infinite jumps, shooting on the way
	local function attackAirChase()
		local t0 = os.clock()
		local lastShot = 0
		while not stopped() and os.clock() - t0 < 3.5 do
			local zy, zz = zenPos()
			local wantZ = zz + ((S.z < zz) and -14 or 14)
			S.vz = math.clamp((wantZ - S.z) * 3, -CFG.WalkSpeed * 1.6, CFG.WalkSpeed * 1.6)
			if S.vy < 2 and S.y < zy - 1 then
				jumpNow(true)
			end
			faceTarget()
			if os.clock() - lastShot > 0.28 then
				lastShot = os.clock()
				setPose("Tiger", true)
				fireTiger(3)
			end
			if not sleep(0.03) then break end
		end
		S.vz = 0
		setPose("Fall", true)
		waitLanding(4)
	end

	local function attackEvade()
		S.evading = true
		S.evadePending = false
		setPose("Walk", true)
		local t0 = os.clock()
		while not stopped() and os.clock() - t0 < 4 do
			local target = S.evadeZ
			if not target or math.abs(S.z - target) < 1 then break end
			S.faceLeft = target < S.z
			S.vz = (target > S.z and 1 or -1) * CFG.WalkSpeed * 1.5
			task.wait()
		end
		S.vz = 0
		S.evading = false
	end

	--// Victory: Zenithega's defeat animation, then Sagat walks back to the start
	S.zenithegaDefeat = function()
		freezeBoss(boss)
		pcall(boss.PlaySound, boss, "Z KO")
		if realBar then realBar.Size = UDim2.fromScale(0, 1) end
		local za = boss.Animators and boss.Animators.Zenithega
		local function play(sig, once, fps)
			if za then
				pcall(function()
					za:Play({ AnimationSignature = sig, Type = "Sprites", Once = once, FPS = fps })
				end)
			end
		end
		play("zng_defeated_1", true, 10)
		local restY = S.floorY + zenPart.Size.Y / 2
		if zenPart.Position.Y > restY + 0.5 then
			local tw = TweenService:Create(zenPart, TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
				CFrame = zenPart.CFrame - Vector3.new(0, zenPart.Position.Y - restY, 0),
			})
			tw:Play()
			tw.Completed:Wait()
			play("zng_defeatland_1", true, 10)
			task.wait(0.5)
		else
			task.wait(1)
		end
		play("zng_defeatloop_1", false, 7)
	end

	S.walkHome = function()
		local t0 = os.clock()
		while S.alive and not S.grounded and os.clock() - t0 < 3 do task.wait() end
		if not S.alive then return end
		setPose("Idle", true)
		task.wait(0.6)
		local homeZ = math.clamp(playerSpawn and playerSpawn.Position.Z or (S.minZ + 18), S.minZ, S.maxZ)
		setPose("Walk", true)
		t0 = os.clock()
		while S.alive and math.abs(S.z - homeZ) > 1 and os.clock() - t0 < 6 do
			S.faceLeft = homeZ < S.z
			S.vz = (homeZ > S.z and 1 or -1) * CFG.WalkSpeed
			task.wait()
		end
		S.vz = 0
		if not S.alive then return end
		local _, tz = zenPos()
		S.faceLeft = tz < S.z
		setPose("Laugh", true)
		playSound(SOUND.LAUGH, 1)
	end

	local function walkTo(targetDist, maxTime)
		waitLanding(2)
		setPose("Walk")
		local t0 = os.clock()
		while os.clock() - t0 < maxTime and not stopped() and not mustCounter() do
			local _, tz = zenPos()
			local dz = tz - S.z
			local d = math.abs(dz)
			faceTarget()
			if d > targetDist + 6 then
				S.vz = (dz > 0 and 1 or -1) * CFG.WalkSpeed
			elseif d < targetDist - 6 then
				S.vz = (dz > 0 and -1 or 1) * CFG.WalkSpeed
				if S.z <= S.minZ + 1 or S.z >= S.maxZ - 1 then break end -- cornered
			else
				break
			end
			task.wait()
		end
		S.vz = 0
		if not stopped() then setPose("Idle") end
	end

	-- an attack runs start to finish; nothing else can interrupt it
	local function runAttack(fn)
		S.busy = true
		fn()
		S.vz = 0
		S.busy = false
		if not stopped() then setPose("Idle") end
	end

	local function pickMove(pool, last)
		local total = 0
		for _, e in ipairs(pool) do
			if e[1] ~= last then total = total + e[2] end
		end
		local r = math.random() * total
		for _, e in ipairs(pool) do
			if e[1] ~= last then
				r = r - e[2]
				if r <= 0 then return e[1] end
			end
		end
		return pool[1][1]
	end

	--// frame update
	local function physics(dt)
		if S.vy ~= 0 or S.y > S.groundY + 0.01 then
			S.vy = S.vy - CFG.Gravity * (S.gravScale or 1) * dt
			S.y = S.y + S.vy * dt
			if S.y <= S.groundY then
				S.y = S.groundY
				S.vy = 0
			end
		end
		S.grounded = S.y <= S.groundY + 0.02
		if S.grounded then S.airJumps = 0 end
		S.z = math.clamp(S.z + S.vz * dt, S.minZ, S.maxZ)
	end

	local scanTimer, hideTimer, counterTimer, fruitTimer = 0, 0, 0, 0
	S.conns[#S.conns + 1] = RunService.RenderStepped:Connect(function(dt)
		if not S.alive then return end
		physics(dt)
		part.CFrame = CFrame.new(S.planeX - 2, S.y - (S.crouching and 2 or 0), S.z) * CFrame.Angles(0, math.pi / 2, 0)
		pcall(anim.Flip, anim, S.faceLeft)

		-- keep your hidden character inside Sagat so her aim and hitboxes track him
		if hrp.Parent then
			hrp.Anchored = true
			local bodyY = S.crouching and (S.floorY - 3) or (S.y - halfHeight + 3)
			hrp.CFrame = CFrame.new(S.planeX, bodyY, S.z)
				* CFrame.Angles(0, S.faceLeft and math.pi or 0, 0)
		end
		hideTimer = hideTimer + dt
		if hideTimer >= 0.5 then
			hideTimer = 0
			setHidden(true)
		end

		fruitTimer = fruitTimer + dt
		if fruitTimer >= 0.1 then
			fruitTimer = 0
			S.fruits = findFruits()
		end
		if not S.over and not S.dead then
			parryWaves()
		end

		updateProjectiles(dt)
		scanTimer = scanTimer + dt
		if scanTimer >= 0.05 then
			scanTimer = 0
			scanZenithegaAttacks()
		end
		counterTimer = counterTimer + dt
		if counterTimer >= 0.15 then
			counterTimer = 0
			if not S.countering and not S.over and os.clock() >= (S.counterCooldown or 0) then
				local urgent = false
				for _, t in ipairs(findCounterTargets()) do
					if t.urgent then urgent = true break end
				end
				S.counterPending = urgent -- only urgent ones may interrupt an attack
			end
		end
		if not S.over and not S.dead then
			dodgeReflex(dt)
		end
	end)

	--// brain: one committed move at a time, then a short recovery
	S.thread = task.spawn(function()
		local ok, err = pcall(function()
			setPose("Idle", true)
			faceTarget()
			playSound(SOUND.LAUGH, 0.8)
			sleep(0.8)

			local last = nil
			while not stopped() do
				waitLanding(2)
				faceTarget()
				local ty, tz = zenPos()
				local dz, dy = math.abs(tz - S.z), ty - S.y
				local move

				if S.evadePending then
					move = attackEvade
				elseif S.climbPending then
					move = attackWallClimb
				elseif S.beamPending then
					move = attackBeamDodge
				elseif S.counterPending or #findCounterTargets() > 0 then
					move = attackCounter
				elseif S.fruitPending or #findFruits() > 0 then
					move = attackFruits
				elseif dz < 14 and math.abs(dy) < 12 and last ~= attackUppercut then
					move = attackUppercut
				elseif dy > 15 then
					-- she's floating out of reach: leap up to her or use homing shots
					if dz > 70 then
						S.busy = true
						walkTo(40, 1.5)
						S.busy = false
					end
					if boss.FinalPhaseActive then
						-- infinite jumps: fly up to her and fight her in the air
						move = pickMove({
							{ attackAirChase, 50 },
							{ attackTigerShot, 20 },
							{ attackOmegaShot, 15 },
							{ attackLeap, 15 },
						}, last)
					else
						move = pickMove({
							{ attackLeap, 45 },
							{ attackTigerShot, 25 },
							{ attackOmegaShot, 20 },
							{ attackJumpShot, 10 },
						}, last)
					end
				else
					-- get to a comfortable range first (walking is its own step)
					if dz > 60 then
						S.busy = true
						walkTo(38, 2)
						S.busy = false
					elseif dz < 14 then
						S.busy = true
						walkTo(30, 1)
						S.busy = false
					end
					move = pickMove({
						{ attackTigerShot, 40 },
						{ attackOmegaShot, 25 },
						{ attackSanic, 20 },
						{ attackJumpShot, 15 },
						{ attackAirChase, boss.FinalPhaseActive and 25 or 0 },
					}, last)
				end

				if stopped() then break end
				if S.evadePending then
					move = attackEvade
				elseif S.climbPending then
					move = attackWallClimb
				elseif S.beamPending then
					move = attackBeamDodge
				elseif S.counterPending and move ~= attackCounter then
					move = attackCounter
				elseif S.fruitPending and move ~= attackFruits then
					move = attackFruits
				end
				local reactive = {
					[attackCounter] = true, [attackEvade] = true, [attackBeamDodge] = true,
					[attackWallClimb] = true, [attackFruits] = true,
				}
				if not reactive[move] then last = move end
				S.gravScale = 1
				runAttack(move)
				S.gravScale = 1
				if stopped() then break end
				if not S.counterPending and not S.evadePending and not S.beamPending
					and not S.climbPending and not S.fruitPending then
					sleep(0.5 + math.random() * 0.4)
				end
			end
		end)
		if not ok then
			warn("[BossBrawl] Sagat AI error: " .. tostring(err))
			setStatus("Sagat AI error (see console)")
		end
	end)

	return S
end

--// Watcher: starts / ends the session around the Zenithega fight
local running = true

local function startSession()
	if Session or Starting or Finished then return end
	local boss, module = getBoss()
	if not boss then
		setStatus("Zenithega module not found")
		return
	end
	Starting = true
	task.spawn(function()
		local ok, S, err = pcall(createSession, boss, module)
		Starting = false
		if not ok then
			err = tostring(S)
			S = nil
		end
		if S then
			Session = S
			if running and Enabled then
				setStatus("Brawl active - Sagat vs Zenithega")
			else
				endSession()
			end
		else
			setStatus(err or "Failed to spawn Sagat")
			Finished = true -- don't retry every tick; resets when the fight ends
		end
	end)
end

task.spawn(function()
	local inactive = 0
	while running do
		task.wait(0.25)
		local boss = getBoss()
		local live = fightIsRunning(boss)
		if not live then
			Finished = false
			if not Session and not Starting then
				unlockHealth()
			end
		end
		if Session then
			if live then
				inactive = 0
			else
				inactive = inactive + 0.25
				if inactive > 1 then
					inactive = 0
					endSession()
				end
			end
		elseif Enabled and not Starting and live then
			inactive = 0
			startSession()
		end
	end
end)

