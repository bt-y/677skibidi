local function isCoinPart(v)
    if not v or not v.Parent or VS[v] then return false end
    if not v:IsA("BasePart") then return false end
    local n = v.Name
    return n == "Coin_Server" or n == "Coin" or n == "Coin_Client"
end

local function rebuildCoinCache()
    coinCache = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name == "CoinContainer" then
            for _, child in ipairs(obj:GetChildren()) do
                if isCoinPart(child) then
                    table.insert(coinCache, child)
                end
            end
        end
    end
    if #coinCache == 0 then
        for _, v in ipairs(workspace:GetDescendants()) do
            if isCoinPart(v) then
                table.insert(coinCache, v)
            end
        end
    end
    lastCoinScan = tick()
    return #coinCache
end

workspace.DescendantAdded:Connect(function(obj)
    task.defer(function()
        if isCoinPart(obj) then
            table.insert(coinCache, obj)
        elseif obj.Name == "TouchInterest" or obj.ClassName == "TouchTransmitter" then
            local p = obj.Parent
            if isCoinPart(p) then table.insert(coinCache, p) end
        end
    end)
end)

task.spawn(function()
    task.wait(0.5)
    rebuildCoinCache()
    while true do
        task.wait(AF and 0.4 or 2)
        rebuildCoinCache()
    end
end)

local function getCoins()
    local list = {}
    for i = #coinCache, 1, -1 do
        local v = coinCache[i]
        if isCoinPart(v) then
            table.insert(list, v)
        else
            table.remove(coinCache, i)
        end
    end
    if #list == 0 then
        rebuildCoinCache()
        for _, v in ipairs(coinCache) do
            if isCoinPart(v) then table.insert(list, v) end
        end
    end
    return list
end

local function coinStillValid(coin)
    if not coin or not coin.Parent or VS[coin] then return false end
    if coin.Name ~= "Coin_Server" and coin.Name ~= "Coin" then return false end
    if not coin:FindFirstChild("TouchInterest") and not coin:FindFirstChildWhichIsA("TouchTransmitter") then
        return false
    end
    return true
end

local FLAT = CFrame.Angles(math.rad(90), 0, 0)

local function touchCoin(coin, root)
    if not coin or not coin.Parent or not root then return end
    pcall(function()
        if firetouchinterest then
            firetouchinterest(root, coin, 0)
            task.wait(0.03)
            firetouchinterest(root, coin, 1)
        end
        pcall(function() firetouchinterest(coin, root, 0) end)
        pcall(function() firetouchinterest(coin, root, 1) end)
    end)
end

-- =========================================================
-- INSTANT TELEPORT COLLECTION (Hard ruled: only tries once)
-- =========================================================
local function goToCoin(root, hum, coin)
    if not root or not coin or not coinStillValid(coin) then return false end
    
    -- Hard rule: Mark as visited immediately so it never retries the same coin 3 or 4 times
    VS[coin] = true

    root.Anchored = false
    if hum then
        hum.PlatformStand = false
        hum.Sit = false
    end
    root.AssemblyLinearVelocity = Vector3.zero

    -- Instant teleport directly to the coin position based on mode
    if FARM_MODE == "Flat" then
        root.CFrame = CFrame.new(coin.Position) * FLAT
    else
        root.CFrame = CFrame.new(coin.Position + Vector3.new(0, 2.5, 0))
    end

    -- Touch once
    touchCoin(coin, root)
    return true
end

local function pickTarget(candidates)
    if #candidates == 0 then return nil end
    table.sort(candidates, function(a, b) return a.dist < b.dist end)
    -- Closest coin mode as requested
    return candidates[1].obj
end

