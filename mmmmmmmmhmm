-- Do NOT disable every ScreenGui: that hides the MM2 HUD and can
-- interfere with the game's normal UI. Only remove objects clearly
-- named as loading UI. Never touch this script's own farm interface.
local function removeNamedLoadingUi(container)
    if not container then return end

    for _, obj in ipairs(container:GetDescendants()) do
        local lowerName = string.lower(obj.Name)
        local isLoadingName = string.find(lowerName, "loading", 1, true) ~= nil
        local isFarmGui = obj.Name == "mm2FarmLight"

        if isLoadingName and not isFarmGui
            and (obj:IsA("ScreenGui") or obj:IsA("GuiObject")) then
            pcall(function()
                obj:Destroy()
            end)
        end
    end
end

local function clearNamedLoadingUi()
    removeNamedLoadingUi(pg)
    removeNamedLoadingUi(ReplicatedFirst)
end

clearNamedLoadingUi()

pg.DescendantAdded:Connect(function(obj)
    if obj.Name ~= "mm2FarmLight"
        and string.find(string.lower(obj.Name), "loading", 1, true)
        and (obj:IsA("ScreenGui") or obj:IsA("GuiObject")) then
        task.defer(clearNamedLoadingUi)
    end
end)

ReplicatedFirst.DescendantAdded:Connect(function()
    task.defer(clearNamedLoadingUi)
end)

task.spawn(function()
    for _ = 1, 120 do
        clearNamedLoadingUi()
        task.wait(0.5)
    end
end)

