-- Hidden/secret MM2 maps are not near 0,0,0 (logs showed Z~9000).
-- Use densest coin cluster instead of absolute world bounds.
local function getCoins()
    local list = {}
    for i = #coinCache, 1, -1 do
        local v = coinCache[i]
        if isCoinPart(v) then
            table.insert(list, v)
        else
            table.remove(coinCache, i)
        end
    end
    if #list == 0 then
        rebuildCoinCache()
        for _, v in ipairs(coinCache) do
            if isCoinPart(v) then table.insert(list, v) end
        end
    end
    return list
end

