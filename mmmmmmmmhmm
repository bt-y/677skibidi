-- MAIN FARMING LOOP (Direct Teleport + 1.8s CD)
-- =========================================================
task.spawn(function()
    local lastClear = tick()
    while true do
        if not AF then
            restoreMovement()
            task.wait(0.4)
        else
            local ch = lp.Character
            local root = ch and ch:FindFirstChild("HumanoidRootPart")
            local hum = ch and ch:FindFirstChild("Humanoid")
            if not (root and hum and hum.Health > 0) then
                task.wait(0.3)
            else
                if tick() - lastClear > 20 then
                    VS = {}
                    lastClear = tick()
                end
                rebuildCoinCache()
                local allCoins = getCoins()
                if #allCoins == 0 then
                    task.wait(0.3)
                else
                    local candidates = {}
                    for _, obj in ipairs(allCoins) do
                        if coinStillValid(obj) then
                            local d = (obj.Position - root.Position).Magnitude
                            if d < RG then
                                table.insert(candidates, {obj = obj, dist = d})
                            end
                        end
                    end
                    local target = nil
                    if #candidates > 0 then
                        table.sort(candidates, function(a, b) return a.dist < b.dist end)
                        target = candidates[1].obj
                    end
                    if not target then
                        for _, obj in ipairs(allCoins) do
                            if coinStillValid(obj) then
                                target = obj
                                break
                            end
                        end
                    end
                    if target then
                        local ok = goToCoin(root, hum, target)
                        if ok then
                            CL = CL + 1
                            lastCollectTick = tick()
                        end
                        task.wait(COIN_DELAY) -- 1.8s delay
                    else
                        task.wait(0.25)
                    end
                end
            end
        end
    end
end)

