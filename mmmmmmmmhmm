local function getCoins()
    local list = {}
    for i = #coinCache, 1, -1 do
        local v = coinCache[i]
        if isCoinPart(v) then
            table.insert(list, v)
        else
            table.remove(coinCache, i)
        end
    end
    if #list == 0 then
        rebuildCoinCache()
        for _, v in ipairs(coinCache) do
            if isCoinPart(v) then table.insert(list, v) end
        end
    end
    return list
end

local function coinStillValid(coin)
    if not coin or not coin.Parent or VS[coin] then return false end
    if coin.Name ~= "Coin_Server" and coin.Name ~= "Coin" then return false end
    if not coin:FindFirstChild("TouchInterest") and not coin:FindFirstChildWhichIsA("TouchTransmitter") then
        return false
    end
    return true
end

local function touchCoin(coin, root)
    if not coin or not coin.Parent or not root then return end
    pcall(function()
        if firetouchinterest then
            firetouchinterest(root, coin, 0)
            task.wait(0.03)
            firetouchinterest(root, coin, 1)
        end
        pcall(function() firetouchinterest(coin, root, 0) end)
        pcall(function() firetouchinterest(coin, root, 1) end)
    end)
end

-- =========================================================
-- DIRECT TELEPORT COLLECTION (Hard-ruled: only tries once per coin)
-- =========================================================
local function goToCoin(root, hum, coin)
    if not root or not coin or not coinStillValid(coin) then return false end
    
    -- Hard rule: Mark as visited immediately so it only tries once
    VS[coin] = true

    root.Anchored = false
    if hum then
        hum.PlatformStand = false
        hum.Sit = false
    end
    root.AssemblyLinearVelocity = Vector3.zero

    -- Direct teleport to the coin position
    root.CFrame = CFrame.new(coin.Position + Vector3.new(0, 2.5, 0))

    -- Touch once to collect
    touchCoin(coin, root)
    return true
end

local function pickTarget(candidates)
    if #candidates == 0 then return nil end
    table.sort(candidates, function(a, b) return a.dist < b.dist end)
    return candidates[1].obj
end

