    return list
end

local function safeMoveTo(root, targetPos, speed)
    if not root or not root.Parent then return false end
    speed = math.clamp(speed or 23, 12, 45)
    local startPos = root.Position
    local dist = (targetPos - startPos).Magnitude
    if dist < 3 then
        root.CFrame = CFrame.new(targetPos)
        return true
    end
    local duration = math.clamp(dist / speed, 0.08, 4)
    local t0 = tick()
    while root and root.Parent do
        local alpha = math.min((tick() - t0) / duration, 1)
        root.CFrame = CFrame.new(startPos:Lerp(targetPos, alpha))
        root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        if alpha >= 1 then return true end
        task.wait()
    end
    return false
end

