local function mkBox(label, value, order, apply)
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -12, 0, 16)
    lbl.BackgroundTransparency = 1
    lbl.Text = label .. ": " .. tostring(value)
    lbl.TextColor3 = Color3.fromRGB(230, 180, 120)
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 12
    lbl.LayoutOrder = order
    lbl.Parent = content
    local box = Instance.new("TextBox")
    box.Size = UDim2.new(1, -12, 0, 28)
    box.BackgroundColor3 = Color3.fromRGB(32, 14, 6)
    box.Text = tostring(value)
    box.TextColor3 = Color3.new(1, 1, 1)
    box.Font = Enum.Font.GothamBold
    box.TextSize = 13
    box.LayoutOrder = order + 1
    box.ClearTextOnFocus = false
    box.Parent = content
    Instance.new("UICorner", box).CornerRadius = UDim.new(0, 5)
    local function commit()
        local n = tonumber(box.Text)
        if n then apply(n, lbl, box) end
    end
    box.FocusLost:Connect(function()
        commit()
    end)
    box:GetPropertyChangedSignal("Text"):Connect(function()
        local n = tonumber(box.Text)
        if n then apply(n, lbl, box) end
    end)
    return box
end

