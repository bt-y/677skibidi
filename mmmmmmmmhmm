local function mkBtn(txt, y, parent)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, -12, 0, 32)
    b.Position = UDim2.new(0, 6, 0, y)
    b.BackgroundColor3 = Color3.fromRGB(40, 32, 80)
    b.Text = txt
    b.TextColor3 = Color3.fromRGB(200, 190, 255)
    b.Font = Enum.Font.GothamBold
    b.TextSize = 12
    b.Parent = parent
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
    return b
end

local function mkToggle(txt, parent, state, cb)
    local st = state
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, -16, 0, 32)
    b.BackgroundColor3 = st and Color3.fromRGB(100, 70, 220) or Color3.fromRGB(28, 22, 55)
    b.Text = txt .. (st and " : ON" or " : OFF")
    b.TextColor3 = Color3.new(1,1,1)
    b.Font = Enum.Font.GothamBold
    b.TextSize = 12
    b.Parent = parent
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
    b.MouseButton1Click:Connect(function()
        st = not st
        b.Text = txt .. (st and " : ON" or " : OFF")
        b.BackgroundColor3 = st and Color3.fromRGB(100, 70, 220) or Color3.fromRGB(28, 22, 55)
        cb(st)
    end)
    return b
end

