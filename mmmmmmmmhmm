local TP_IF_FAR = 140
local TP_COOLDOWN = 3
local lastTpTick = 0

-- Go to coin; supports mid-travel retarget. Returns true if collected attempt done.
local function goToCoin(root, hum, coin, speed)
    if not root or not coin then return false end
    local current = coin
    local hops = 0
    while current and hops < 8 do
        hops = hops + 1
        if not coinStillValid(current) then
            VS[current] = true
            current = findBetterCoin(root, nil, math.huge)
            if not current then return false end
        end
        local dest = current.Position + Vector3.new(0, 2.5, 0)
        local dist = (current.Position - root.Position).Magnitude
        root.Anchored = false
        if hum then
            hum.PlatformStand = false
            hum.Sit = false
        end
        root.AssemblyLinearVelocity = Vector3.zero
        -- Rare far TP with cooldown (anti kick spam)
        if dist > TP_IF_FAR and (tick() - lastTpTick) >= TP_COOLDOWN then
            lastTpTick = tick()
            if FARM_MODE == "Flat" then
                setNoclip(true)
                root.CFrame = CFrame.new(current.Position) * FLAT
            else
                setNoclip(false)
                root.CFrame = CFrame.new(dest)
            end
            touchCoin(current, root)
            task.wait(0.06)
            touchCoin(current, root)
            if not coinStillValid(current) then
                VS[current] = true
                return true
            end
        end
        moveToken = moveToken + 1
        local reached, newT
        if FARM_MODE == "Flat" then
            if hum then hum.AutoRotate = false end
            setNoclip(true)
            reached, newT = moveFlat(root, current, speed)
        else
            if hum then hum.AutoRotate = true end
            setNoclip(NOCLIP)
            reached, newT = moveSurface(root, current, speed)
        end
        if newT and newT ~= current then
            current = newT
            -- continue loop toward new target without counting collect
        elseif reached then
            local tWait = tick()
            while tick() - tWait < 0.45 do
                if not (root and root.Parent) then break end
                if not coinStillValid(current) then break end
                if FARM_MODE == "Flat" then
                    root.CFrame = CFrame.new(current.Position) * FLAT
                else
                    root.CFrame = CFrame.new(current.Position + Vector3.new(0, 2.5, 0))
                end
                touchCoin(current, root)
                task.wait(0.04)
            end
            VS[current] = true
            return true
        else
            if current then VS[current] = true end
            return false
        end
    end
    return false
end

local function pickTarget(candidates)
    if #candidates == 0 then return nil end
    table.sort(candidates, function(a, b) return a.dist < b.dist end)
    if COIN_MODE == "Closest" then
        return candidates[1].obj
    end
    -- Spread: random among closest few so alts don't stack
    local pool = math.min(5, #candidates)
    return candidates[math.random(1, pool)].obj
end


