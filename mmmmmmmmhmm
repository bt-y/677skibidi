-- (REMOVE DEFAULT LOADING SCREEN + HIDE OTHER SCREENGUIS)
-- =========================================================
local ReplicatedFirst = game:GetService("ReplicatedFirst")
local StarterGui = game:GetService("StarterGui")

-- Roblox's built-in loading screen has no ScreenGui name to search for.
-- This is the official API for dismissing that specific loading screen.
pcall(function()
    ReplicatedFirst:RemoveDefaultLoadingScreen()
end)

-- MM2's custom loading overlay does not have a publicly documented,
-- guaranteed ScreenGui name. Hide every ScreenGui except this script's UI.
local function hideScreenGuis(container)
    if not container then return end

    local function hideIfScreenGui(obj)
        if obj:IsA("ScreenGui") and obj.Name ~= "mm2FarmLight" then
            pcall(function()
                obj.Enabled = false
            end)
        end
    end

    for _, obj in ipairs(container:GetDescendants()) do
        hideIfScreenGui(obj)
    end

    for _, obj in ipairs(container:GetChildren()) do
        hideIfScreenGui(obj)
    end
end

local function hideAllOtherScreens()
    hideScreenGuis(pg)
    hideScreenGuis(ReplicatedFirst)
end

hideAllOtherScreens()

-- Catch ScreenGuis that MM2 creates after the script starts.
pg.DescendantAdded:Connect(function(obj)
    if obj:IsA("ScreenGui") and obj.Name ~= "mm2FarmLight" then
        task.defer(function()
            pcall(function() obj.Enabled = false end)
        end)
    end
end)

ReplicatedFirst.DescendantAdded:Connect(function(obj)
    if obj:IsA("ScreenGui") then
        task.defer(function()
            pcall(function() obj.Enabled = false end)
        end)
    end
end)

-- Re-apply briefly in case the game enables or recreates its loading UI.
task.spawn(function()
    for _ = 1, 120 do
        hideAllOtherScreens()
        task.wait(0.5)
    end
end)

