-- Safe move: duration = distance/speed (faster response, less idle delay)
local function coinStillValid(coin)
    if not coin or not coin.Parent or VS[coin] then return false end
    if coin.Name ~= "Coin_Server" and coin.Name ~= "Coin" then return false end
    if not coin:FindFirstChild("TouchInterest") and not coin:FindFirstChildWhichIsA("TouchTransmitter") then
        return false
    end
    return true
end

local FLAT = CFrame.Angles(math.rad(90), 0, 0)

-- Scan for a better live coin while moving (mid-travel switch)
local function findBetterCoin(root, current, remainingDist)
    local best, bestDist = nil, math.huge
    for _, obj in ipairs(getCoins()) do
        if coinStillValid(obj) then
            local d = (obj.Position - root.Position).Magnitude
            if d < bestDist and d < RG then
                bestDist = d
                best = obj
            end
        end
    end
    if not current or not coinStillValid(current) then
        return best
    end
    if best and best ~= current and bestDist + 2 < remainingDist then
        return best
    end
    return nil
end

-- Surface move with mid-travel cancel + switch
-- returns: reached (bool), newTarget (coin or nil)
local function moveSurface(root, target, speed)
    if not root or not root.Parent or not target then return false, nil end
    speed = math.clamp(speed or SP or 14, 5, 40)
    local dest = target.Position + Vector3.new(0, 2.5, 0)
    local startPos = root.Position
    local dist = (dest - startPos).Magnitude
    if dist < 3.5 then
        root.CFrame = CFrame.new(dest)
        return true, nil
    end
    local duration = math.clamp(dist / speed, 0.08, 4)
    local t0 = tick()
    local myToken = moveToken
    while root and root.Parent do
        if myToken ~= moveToken then return false, nil end
        if not coinStillValid(target) then
            VS[target] = true
            local better = findBetterCoin(root, nil, math.huge)
            return false, better
        end
        local remaining = (dest - root.Position).Magnitude
        local better = findBetterCoin(root, target, remaining)
        if better then
            return false, better
        end
        local alpha = math.min((tick() - t0) / duration, 1)
        local s = alpha * alpha * (3 - 2 * alpha)
        root.CFrame = CFrame.new(startPos:Lerp(dest, s))
        root.AssemblyLinearVelocity = Vector3.zero
        if alpha >= 1 then return true, nil end
        task.wait()
    end
    return false, nil
end

-- Flat move with mid-travel cancel + switch
local function moveFlat(root, target, speed)
    if not root or not root.Parent or not target then return false, nil end
    setNoclip(true)
    speed = math.clamp(speed or SP or 14, 5, 40)
    local dest = target.Position
    local startPos = root.Position
    local dist = (dest - startPos).Magnitude
    if dist < 1.8 then
        root.CFrame = CFrame.new(dest) * FLAT
        root.AssemblyLinearVelocity = Vector3.zero
        return true, nil
    end
    local duration = math.clamp(dist / speed, 0.05, 3)
    local t0 = tick()
    local myToken = moveToken
    while root and root.Parent do
        if myToken ~= moveToken then return false, nil end
        if not coinStillValid(target) then
            VS[target] = true
            local better = findBetterCoin(root, nil, math.huge)
            return false, better
        end
        local remaining = (dest - root.Position).Magnitude
        local better = findBetterCoin(root, target, remaining)
        if better then
            return false, better
        end
        local alpha = math.min((tick() - t0) / duration, 1)
        local p = startPos:Lerp(dest, alpha)
        root.CFrame = CFrame.new(p) * FLAT
        root.AssemblyLinearVelocity = Vector3.zero
        if alpha >= 1 then return true, nil end
        task.wait()
    end
    return false, nil
end

local function touchCoin(coin, root)
    if not coin or not coin.Parent or not root then return end
    pcall(function()
        if firetouchinterest then
            firetouchinterest(root, coin, 0)
            task.wait(0.03)
            firetouchinterest(root, coin, 1)
        end
        pcall(function() firetouchinterest(coin, root, 0) end)
        pcall(function() firetouchinterest(coin, root, 1) end)
    end)
end

