-- Safe move: duration = distance/speed (faster response, less idle delay)
local function coinStillValid(coin)
    if not coin or not coin.Parent or VS[coin] then return false end
    if not coin:IsA("BasePart") then return false end
    local name = coin.Name
    if name ~= "Coin_Server" and name ~= "Coin" and name ~= "Coin_Client" then
        return false
    end
    -- Some MM2 coin instances do not expose TouchInterest to the client.
    -- Do not discard an otherwise valid coin just because that child is absent.
    return true
end

local FLAT = CFrame.Angles(math.rad(90), 0, 0)

-- Scan for a better live coin while moving (mid-travel switch)
-- Per-account salt so alts don't always roll the same random
local function accountSalt()
    return (lp.UserId % 997) + (lp.UserId % 17) * 13
end

local function listLiveCoins(root, maxDist)
    local list = {}
    for _, obj in ipairs(getCoins()) do
        if coinStillValid(obj) then
            local d = (obj.Position - root.Position).Magnitude
            if d < (maxDist or RG) then
                table.insert(list, {obj = obj, dist = d})
            end
        end
    end
    table.sort(list, function(a, b) return a.dist < b.dist end)
    return list
end

-- Pick a coin for Spread: score by distance + stable hash so accounts prefer different coins
local function spreadPick(list)
    if #list == 0 then return nil end
    if #list == 1 then return list[1].obj end
    local pool = math.min(12, #list)
    local bestScore, bestObj = math.huge, list[1].obj
    local salt = accountSalt()
    for i = 1, pool do
        local e = list[i]
        -- lower score = more preferred; each account hashes coin position differently
        local hx = math.floor(e.obj.Position.X * 0.5) + math.floor(e.obj.Position.Z * 0.5) * 31
        local jitter = ((hx + salt * 17 + i * 3) % 100) / 100
        local score = e.dist * (0.55 + jitter * 0.9)
        if score < bestScore then
            bestScore = score
            bestObj = e.obj
        end
    end
    return bestObj
end

-- Mid-travel: only retarget if current coin is DEAD (taken).
-- In Closest mode, also allow switch to a clearly closer coin.
-- In Spread mode, do NOT steal toward the global closest (that makes all alts stack).
local function findBetterCoin(root, current, remainingDist)
    if current and coinStillValid(current) then
        if COIN_MODE == "Spread" then
            return nil -- keep current target; only abandon when taken
        end
        -- Closest: switch if another coin is clearly nearer than remaining path
        local list = listLiveCoins(root, RG)
        if #list == 0 then return nil end
        local best = list[1]
        if best.obj ~= current and best.dist + 2 < remainingDist then
            return best.obj
        end
        return nil
    end
    -- current invalid/taken -> pick a new one
    local list = listLiveCoins(root, RG)
    if #list == 0 then return nil end
    if COIN_MODE == "Closest" then
        return list[1].obj
    end
    return spreadPick(list)
end

-- Surface move with mid-travel cancel + switch
-- returns: reached (bool), newTarget (coin or nil)
local function moveSurface(root, target, speed)
    if not root or not root.Parent or not target then return false, nil end
    speed = math.clamp(speed or SP or 16, 5, 20)
    local dest = target.Position + Vector3.new(0, 2.5, 0)
    local startPos = root.Position
    local dist = (dest - startPos).Magnitude
    if dist < 3.5 then
        root.CFrame = CFrame.new(dest)
        return true, nil
    end
    local duration = math.clamp(dist / speed, 0.08, 4)
    local t0 = tick()
    local myToken = moveToken
    while root and root.Parent do
        if myToken ~= moveToken then return false, nil end
        if not coinStillValid(target) then
            VS[target] = true
            local better = findBetterCoin(root, nil, math.huge)
            return false, better
        end
        local remaining = (dest - root.Position).Magnitude
        local better = findBetterCoin(root, target, remaining)
        if better then
            return false, better
        end
        local alpha = math.min((tick() - t0) / duration, 1)
        local s = alpha * alpha * (3 - 2 * alpha)
        root.CFrame = CFrame.new(startPos:Lerp(dest, s))
        root.AssemblyLinearVelocity = Vector3.zero
        if alpha >= 1 then return true, nil end
        task.wait()
    end
    return false, nil
end

-- Flat move with mid-travel cancel + switch
local function moveFlat(root, target, speed)
    if not root or not root.Parent or not target then return false, nil end
    setNoclip(true)
    speed = math.clamp(speed or SP or 16, 5, 20)
    local dest = target.Position
    local startPos = root.Position
    local dist = (dest - startPos).Magnitude
    if dist < 1.8 then
        root.CFrame = CFrame.new(dest) * FLAT
        root.AssemblyLinearVelocity = Vector3.zero
        return true, nil
    end
    local duration = math.clamp(dist / speed, 0.05, 3)
    local t0 = tick()
    local myToken = moveToken
    while root and root.Parent do
        if myToken ~= moveToken then return false, nil end
        if not coinStillValid(target) then
            VS[target] = true
            local better = findBetterCoin(root, nil, math.huge)
            return false, better
        end
        local remaining = (dest - root.Position).Magnitude
        local better = findBetterCoin(root, target, remaining)
        if better then
            return false, better
        end
        local alpha = math.min((tick() - t0) / duration, 1)
        local p = startPos:Lerp(dest, alpha)
        root.CFrame = CFrame.new(p) * FLAT
        root.AssemblyLinearVelocity = Vector3.zero
        if alpha >= 1 then return true, nil end
        task.wait()
    end
    return false, nil
end

local function touchCoin(coin, root)
    if not coin or not coin.Parent or not root then return end
    if type(firetouchinterest) == "function" then
        pcall(function()
            firetouchinterest(root, coin, 0)
            task.wait(0.01)
            firetouchinterest(root, coin, 1)
        end)
    end
end

local function touchCoinFast(coin, root)
    if not coin or not root then return end
    for _ = 1, 2 do
        pcall(function()
            if firetouchinterest then
                firetouchinterest(root, coin, 0)
                firetouchinterest(root, coin, 1)
                firetouchinterest(coin, root, 0)
                firetouchinterest(coin, root, 1)
            end
        end)
        task.wait(0.01)
    end
end

