local function isCoinPart(v)
    if not v or not v.Parent or VS[v] then return false end
    if not v:IsA("BasePart") then return false end
    local n = v.Name
    return n == "Coin_Server" or n == "Coin" or n == "Coin_Client"
end

local function rebuildCoinCache()
    coinCache = {}
    -- Prefer CoinContainer (fast + reliable)
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name == "CoinContainer" then
            for _, child in ipairs(obj:GetChildren()) do
                if isCoinPart(child) then
                    table.insert(coinCache, child)
                end
            end
        end
    end
    if #coinCache == 0 then
        for _, v in ipairs(workspace:GetDescendants()) do
            if isCoinPart(v) then
                table.insert(coinCache, v)
            end
        end
    end
    lastCoinScan = tick()
    return #coinCache
end

