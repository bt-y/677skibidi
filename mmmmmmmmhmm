task.spawn(function()
    local lastClear = tick()
    local lastStatus = 0
    while true do
        local loopOk, loopErr = pcall(function()
        if not AF then
            restoreMovement()
            task.wait(0.4)
        else
            local ch = lp.Character
            local root = ch and ch:FindFirstChild("HumanoidRootPart")
            local hum = ch and ch:FindFirstChild("Humanoid")
            if not (root and hum and hum.Health > 0) then
                task.wait(0.3)
            else
                if tick() - lastClear > 20 then
                    VS = {}
                    lastClear = tick()
                end
                rebuildCoinCache()
                local allCoins = getCoins()
                if #allCoins == 0 then
                    task.wait(0.3)
                else
                    local candidates = {}
                    for _, obj in ipairs(allCoins) do
                        if coinStillValid(obj) then
                            local d = (obj.Position - root.Position).Magnitude
                            if d < RG then
                                table.insert(candidates, {obj = obj, dist = d})
                            end
                        end
                    end
                    local target = nil
                    if #candidates > 0 then
                        target = pickTarget(candidates)
                    end
                    if not target then
                        -- pick any live coin and go (may TP if far)
                        for _, obj in ipairs(allCoins) do
                            if coinStillValid(obj) then
                                target = obj
                                break
                            end
                        end
                    end
                    if target then
                        local ok = goToCoin(root, hum, target, SP)
                        -- always mark so we never park on the same part
                        VS[target] = true
                        if ok then
                            CL = CL + 1
                            lastCollectTick = tick()
                        end
                        -- only this wait is the user CD (textbox). keep it short-capable.
                        local cd = tonumber(COIN_DELAY) or 0.5
                        if cd < 0.05 then cd = 0.05 end
                        if cd > 5 then cd = 5 end
                        task.wait(cd)
                    else
                        task.wait(0.15)
                    end
                end
            end
        end
        end)

        if not loopOk then
            warn("[Farm] Loop error:", loopErr)
            task.wait(0.5)
        elseif tick() - lastStatus > 10 then
            lastStatus = tick()
            local count = 0
            pcall(function() count = #getCoins() end)
            print("[Farm] Running | AF=" .. tostring(AF) .. " | visible coins=" .. tostring(count))
        end
    end
end)


