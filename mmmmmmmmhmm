local TP_IF_FAR = 220
local TP_COOLDOWN = 8
local lastTpTick = 0

-- Go to coin; supports mid-travel retarget. Returns true if collected attempt done.
local function goToCoin(root, hum, coin, speed)
    if not root or not coin then return false end
    local current = coin
    local hops = 0
    while current and hops < 8 do
        hops = hops + 1
        if not coinStillValid(current) then
            VS[current] = true
            current = findBetterCoin(root, nil, math.huge)
            if not current then return false end
        end
        root.Anchored = false
        if hum then
            hum.PlatformStand = false
            hum.Sit = false
        end
        root.AssemblyLinearVelocity = Vector3.zero
        moveToken = moveToken + 1
        local reached, newT
        if FARM_MODE == "FastUnder" then
            reached, newT = moveFastUnder(root, hum, current, speed)
        elseif FARM_MODE == "Flat" then
            if hum then hum.AutoRotate = false end
            setNoclip(true)
            reached, newT = moveFlat(root, current, speed)
        else
            if hum then hum.AutoRotate = true end
            setNoclip(NOCLIP)
            reached, newT = moveSurface(root, current, speed)
        end
        if newT and newT ~= current then
            current = newT
        elseif reached then
            -- Quick touch then ALWAYS leave this coin (no 2s hover / no retry loop)
            if current and current.Parent then
                if FARM_MODE == "Flat" then
                    root.CFrame = CFrame.new(current.Position) * FLAT
                else
                    root.CFrame = CFrame.new(current.Position + Vector3.new(0, 1.5, 0))
                end
                touchCoin(current, root)
                touchCoinFast(current, root)
            end
            -- Blacklist immediately so next loop picks a DIFFERENT coin
            if current then VS[current] = true end
            return true
        else
            -- move aborted (retarget fail / token cancel) - still blacklist to avoid sticky target
            if current then VS[current] = true end
            return false
        end
    end
    return false
end

local function pickTarget(candidates)
    if #candidates == 0 then return nil end
    table.sort(candidates, function(a, b) return a.dist < b.dist end)
    if COIN_MODE == "Closest" then
        return candidates[1].obj
    end
    -- Spread: distance + per-account hash (not pure random closest-5)
    return spreadPick(candidates)
end


