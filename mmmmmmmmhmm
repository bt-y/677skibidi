local function flingMurder()
    if not FLING_ENABLED then return end
    if flinging then return end
    if tick() - lastFling < 8 then return end
    local murd = getMurderer()
    if not murd then return end
    if WL[murd.Name] then
        print("[Fling] Murder is listed - ignored")
        return
    end
    local mChar = murd.Character
    local mRoot = mChar and mChar:FindFirstChild("HumanoidRootPart")
    local ch = lp.Character
    local root = ch and ch:FindFirstChild("HumanoidRootPart")
    local hum = ch and ch:FindFirstChild("Humanoid")
    if not mRoot or not root or not hum then return end

    flinging = true
    lastFling = tick()
    print("[Fling] All listed done - flinging", murd.Name)

    task.spawn(function()
        setVoidProtect(true)
        setNoclip(true)
        local t0 = tick()
        while tick() - t0 < 3.5 do
            if not mRoot or not mRoot.Parent then break end
            if not root or not root.Parent then break end
            -- Bail out of void mid-fling
            if root.Position.Y < -80 then
                print("[Fling] Hit void - abort + recover")
                break
            end
            root.Anchored = false
            hum.PlatformStand = true
            root.CFrame = mRoot.CFrame * CFrame.new(0, 0, 1)
            root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            root.AssemblyAngularVelocity = Vector3.new(9e3, 9e3, 9e3)
            task.wait(0.05)
        end
        if root and root.Parent then
            root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
            root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            if root.Position.Y < -50 then
                local p = root.Position
                root.CFrame = CFrame.new(p.X, 40, p.Z)
            end
        end
        if hum and hum.Parent then
            hum.PlatformStand = false
        end
        flinging = false
        clearListedDone()
        print("[Fling] Done")
    end)
end

